+/* RG DS Plus port: face-button swaps for this game only, a mask: 1 = A<->B,
+ * 2 = X<->Y. Rewriting the SDL mapping of the opened GUID moves every consumer at
+ * once (PSX pad word, the port's raw action binds, button events), without touching
+ * the firmware's mapping. SDL keeps one mapping per GUID for the whole process, so a
+ * GUID is swapped exactly once: a second rewrite after a replug would swap it back. */
+int g_cfg_swapFaceButtons = 0;
+static SDL_JoystickGUID s_swappedGuids[8];
+static int s_swappedGuidCount = 0;
+
+static void PsyX_Pad_ApplyFaceSwap(SDL_GameController* gc)
+{
+	static const char* const pairs[4][2] = { { "a:", "b:" }, { "b:", "a:" }, { "x:", "y:" }, { "y:", "x:" } };
+	char* map;
+	char* out;
+	const char* values[4] = { NULL, NULL, NULL, NULL };
+	int lengths[4] = { 0, 0, 0, 0 };
+	SDL_JoystickGUID guid;
+	size_t size;
+	int i;
+
+	if (!g_cfg_swapFaceButtons || !gc)
+		return;
+	guid = SDL_JoystickGetGUID(SDL_GameControllerGetJoystick(gc));
+	for (i = 0; i < s_swappedGuidCount; i++)
+		if (!memcmp(&s_swappedGuids[i], &guid, sizeof(guid)))
+			return;
+	map = SDL_GameControllerMapping(gc);
+	if (!map)
+		return;
+
+	for (const char* field = strchr(map, ','); field; field = strchr(field + 1, ','))
+	{
+		const char* start = field + 1;
+		const char* end = strchr(start, ',');
+		for (i = 0; i < 4; i++)
+		{
+			if (!strncmp(start, pairs[i][0], 2))
+			{
+				values[i] = start + 2;
+				lengths[i] = (int)((end ? end : start + strlen(start)) - values[i]);
+			}
+		}
+	}
+	if (((g_cfg_swapFaceButtons & 1) && (!values[0] || !values[1])) ||
+		((g_cfg_swapFaceButtons & 2) && (!values[2] || !values[3])))
+	{
+		eprintwarn("[PAD] face-button swap skipped: mapping lacks a/b/x/y: %s\n", map);
+		SDL_free(map);
+		return;
+	}
+
+	size = strlen(map) + 64;
+	out = (char*)SDL_malloc(size);
+	if (!out)
+	{
+		SDL_free(map);
+		return;
+	}
+	out[0] = '\0';
+	{
+		const char* cursor = map;
+		size_t used = 0;
+		while (*cursor)
+		{
+			const char* end = strchr(cursor, ',');
+			size_t length = end ? (size_t)(end - cursor) : strlen(cursor);
+			int replaced = 0;
+			if (cursor != map && length > 2)
+			{
+				for (i = 0; i < 4; i++)
+				{
+					if (!(g_cfg_swapFaceButtons & (i < 2 ? 1 : 2)))
+						continue;
+					if (!strncmp(cursor, pairs[i][0], 2))
+					{
+						int source = i ^ 1;
+						used += SDL_snprintf(out + used, size - used, "%.2s%.*s", pairs[i][0], lengths[source], values[source]);
+						replaced = 1;
+						break;
+					}
+				}
+			}
+			if (!replaced)
+				used += SDL_snprintf(out + used, size - used, "%.*s", (int)length, cursor);
+			if (!end)
+				break;
+			used += SDL_snprintf(out + used, size - used, ",");
+			cursor = end + 1;
+		}
+	}
+
+	if (SDL_GameControllerAddMapping(out) >= 0)
+	{
+		if (s_swappedGuidCount < (int)(sizeof(s_swappedGuids) / sizeof(s_swappedGuids[0])))
+			s_swappedGuids[s_swappedGuidCount++] = guid;
+		eprintinfo("[PAD] face buttons swapped (%s%s%s): %s\n", (g_cfg_swapFaceButtons & 1) ? "A<->B" : "",
+			g_cfg_swapFaceButtons == 3 ? ", " : "", (g_cfg_swapFaceButtons & 2) ? "X<->Y" : "", out);
+	}
+	else
+	{
+		eprintwarn("[PAD] face-button swap rejected by SDL: %s\n", SDL_GetError());
+	}
+	SDL_free(out);
+	SDL_free(map);
+}
+
+extern "C" void PsyX_Pad_SetFaceSwap(int mask)
+{
+	g_cfg_swapFaceButtons = mask & 3;
+	for (int i = 0; i < MAX_CONTROLLERS; i++)
+		PsyX_Pad_ApplyFaceSwap(g_controllers[i].gc);
+}
