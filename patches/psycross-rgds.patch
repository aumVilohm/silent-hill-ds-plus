+/* RG DS seam fill: prims of characters and held items stay unexpanded (their
+ * layered parts, an ear under the hair, would peek through each other's edges).
+ * The game raises g_PsyX_RgdsNoSeam around those draws and addPrim records the
+ * prims here, stamped with the frame generation (bumped at EndScene, after the
+ * frame's parse); the SZ table cannot carry it: with PGXP off it is wiped at the
+ * start of GsDrawOt, before the parse reads it. */
+extern "C" { int g_PsyX_RgdsNoSeam = 0; }
+#define RGDS_NOSEAM_SIZE 8192
+static struct { uintptr_t key; unsigned gen; } s_rgdsNoSeam[RGDS_NOSEAM_SIZE];
+
+static void RgdsNoSeamPut(uintptr_t key)
+{
+	const int slot = (int)((key >> 2) & (RGDS_NOSEAM_SIZE - 1));
+	for (int i = 0; i < 8; i++)
+	{
+		const int s = (slot + i) & (RGDS_NOSEAM_SIZE - 1);
+		if (s_rgdsNoSeam[s].gen != s_pgxpGen || s_rgdsNoSeam[s].key == key)
+		{
+			s_rgdsNoSeam[s].key = key;
+			s_rgdsNoSeam[s].gen = s_pgxpGen;
+			return;
+		}
+	}
+	s_rgdsNoSeam[slot].key = key;
+	s_rgdsNoSeam[slot].gen = s_pgxpGen;
+}
+
+static bool RgdsNoSeamHas(const void* prim)
+{
+	const uintptr_t key = (uintptr_t)prim;
+	const int slot = (int)((key >> 2) & (RGDS_NOSEAM_SIZE - 1));
+	for (int i = 0; i < 8; i++)
+	{
+		const int s = (slot + i) & (RGDS_NOSEAM_SIZE - 1);
+		if (s_rgdsNoSeam[s].gen != s_pgxpGen)
+			return false;
+		if (s_rgdsNoSeam[s].key == key)
+			return true;
+	}
+	return false;
+}
