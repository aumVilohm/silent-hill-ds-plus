+/* RG DS seam fill (SH_RGDS_SEAM_EXPAND, in PS1 pixels; 0.35 by default with SH_RGDS,
+ * 0 turns it off). Polygon edges that do not share vertices meet only to within PS1
+ * integer rounding. At 320x240 those slivers rarely cover a pixel centre; at the
+ * 1024x768 render they show as hairlines of the fog colour that flicker while the
+ * camera moves. Opaque 3D polygons get each edge pushed out by this much (mitred,
+ * capped at twice) so neighbours overlap; the fragment shader clamps their UVs to the
+ * polygon's own bounds (RGDS_SEAM_CLAMP) so the fringe repeats the edge texel. */
+/* Read from the environment on first use; the SEAM console command overrides it. */
+extern "C" { float g_PsyX_RgdsSeamExpand = -1.0f; }
+static bool  s_rgdsExpandNext;
+
+float PsyX_RgdsSeamExpand()
+{
+	if (g_PsyX_RgdsSeamExpand < 0.0f)
+	{
+		const char* value = getenv("SH_RGDS_SEAM_EXPAND");
+		g_PsyX_RgdsSeamExpand = getenv("SH_RGDS") ? (value ? (float)atof(value) : 0.35f) : 0.0f;
+		if (!(g_PsyX_RgdsSeamExpand > 0.0f && g_PsyX_RgdsSeamExpand <= 2.0f))
+			g_PsyX_RgdsSeamExpand = 0.0f;
+		eprintf("*RG DS seam expand: %.2f PS1 px\n", g_PsyX_RgdsSeamExpand);
+	}
+	return g_PsyX_RgdsSeamExpand;
