--- /dev/null
+++ b/src/render/rgds_uniform_cache.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef RGDS_UNIFORM_CACHE_H
+#define RGDS_UNIFORM_CACHE_H
+
+#include <stdint.h>
+#include <string.h>
+
+class RgdsUniformCache
+{
+    struct Value {
+        uint32_t epoch;
+        unsigned char kind, bytes, data[64];
+    };
+    struct Program {
+        uint32_t id;
+        Value values[128];
+    } programs[8] = {};
+    uint32_t epoch = 1;
+
+public:
+    void invalidate()
+    {
+        if (++epoch == 0) {
+            memset(programs, 0, sizeof(programs));
+            epoch = 1;
+        }
+    }
+
+    bool unchanged(uint32_t program, int location, unsigned char kind, const void* data, size_t bytes)
+    {
+        if (!program || program == UINT32_MAX || location < 0 || location >= 128 || !bytes || bytes > 64)
+            return false;
+        for (Program& p : programs) {
+            if (!p.id) p.id = program;
+            if (p.id != program) continue;
+            Value& value = p.values[location];
+            if (value.epoch == epoch && value.kind == kind && value.bytes == bytes &&
+                memcmp(value.data, data, bytes) == 0)
+                return true;
+            value.epoch = epoch;
+            value.kind = kind;
+            value.bytes = (unsigned char)bytes;
+            memcpy(value.data, data, bytes);
+            return false;
+        }
+        return false;
+    }
+};
+
+#endif
