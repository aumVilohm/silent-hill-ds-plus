+
+static void RgdsExpandPoly(GrVertex* v, int n)
+{
+	const float e = PsyX_RgdsSeamExpand();
+	int   idx[4], m = 0, i;
+	float area = 0.0f, nx[4], ny[4];
+
+	if (e <= 0.0f)
+		return;
+	/* A triangle sent as a quad repeats a corner: work on the distinct corners. */
+	for (i = 0; i < n; i++)
+		if (m == 0 || v[i].x != v[idx[m - 1]].x || v[i].y != v[idx[m - 1]].y)
+			idx[m++] = i;
+	if (m > 1 && v[idx[m - 1]].x == v[idx[0]].x && v[idx[m - 1]].y == v[idx[0]].y)
+		m--;
+	if (m < 3)
+		return;
+	for (i = 0; i < m; i++)
+	{
+		const GrVertex& a = v[idx[i]];
+		const GrVertex& b = v[idx[(i + 1) % m]];
+		area += a.x * b.y - b.x * a.y;
+	}
+	if (fabsf(area) < 1.0f)
+		return; /* sliver: leave it alone */
+	const float sign = area > 0.0f ? 1.0f : -1.0f;
+	for (i = 0; i < m; i++) /* outward normal of edge i -> i+1 */
+	{
+		const float dx = v[idx[(i + 1) % m]].x - v[idx[i]].x;
+		const float dy = v[idx[(i + 1) % m]].y - v[idx[i]].y;
+		const float len = sqrtf(dx * dx + dy * dy);
+		nx[i] = sign * dy / len;
+		ny[i] = -sign * dx / len;
+	}
+	float ox[4], oy[4];
+	for (i = 0; i < m; i++)
+	{
+		const int   prev = (i + m - 1) % m;
+		const float mx = nx[prev] + nx[i], my = ny[prev] + ny[i];
+		float d = 1.0f + nx[prev] * nx[i] + ny[prev] * ny[i];
+		if (d < 0.5f)
+			d = 0.5f;
+		ox[i] = mx * e / d;
+		oy[i] = my * e / d;
+	}
+	for (i = 0; i < n; i++)
+	{
+		int k = 0;
+		while (k < m - 1 && (v[idx[k]].x != v[i].x || v[idx[k]].y != v[i].y))
+			k++;
+		v[i].x += ox[k];
+		v[i].y += oy[k];
+	}
+}
