diff --git a/pc_port/include/pc_host_pointer.h b/pc_port/include/pc_host_pointer.h
new file mode 100644
index 0000000..2906908
--- /dev/null
+++ b/pc_port/include/pc_host_pointer.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PC_HOST_POINTER_H
+#define PC_HOST_POINTER_H
+#include <stdint.h>
+
+static inline int Pc_HostPointerValid(const void* pointer, uintptr_t minimum)
+{
+    uintptr_t address = (uintptr_t)pointer;
+#if defined(__aarch64__) && !defined(_WIN32)
+    /* Linux AArch64 stacks and PIE images can lie above x86-64's 47-bit limit. */
+    return address >= minimum && address < 0x0100000000000000ULL;
+#else
+    return address >= minimum && address < 0x0000800000000000ULL;
+#endif
+}
+#endif
