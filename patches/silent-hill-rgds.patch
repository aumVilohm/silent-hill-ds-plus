+/* RG DS Plus: the world and the bottom-menu process share one config.cfg. Only
+ * the world writes it, and a rewrite goes through a temporary file so the other
+ * process never reads a half-written config (a truncated read dropped map= and
+ * enable_debug_log= and booted the menu into the wrong map). */
+static FILE* PcConfig_OpenRewrite(char* tmpPath, size_t size)
+{
+#if defined(SH_RGDS) && defined(__linux__)
+    const char* role = getenv("SH_RGDS_ROLE");
+    if (role && strcmp(role, "inventory") == 0)
+        return NULL;
+    snprintf(tmpPath, size, "%s.tmp", s_configPath);
+    return fopen(tmpPath, "w");
+#else
+    (void)size;
+    tmpPath[0] = '\0';
+    return fopen(s_configPath, "w");
+#endif
+}
+
+static void PcConfig_CommitRewrite(FILE* f, const char* tmpPath)
+{
+    if (fclose(f) == 0 && tmpPath[0] != '\0')
+        rename(tmpPath, s_configPath);
+    else if (tmpPath[0] != '\0')
+        remove(tmpPath);
+}
