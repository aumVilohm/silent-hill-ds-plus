+int RgDs_NativeTakeTap(int* x, int* y);
+const char* RgDs_NativeStatusText(void);
+
+/* Bottom-screen command list, drawn larger for fingers (item_screens_2.c) and
+ * hit-tested with the same numbers (pc_inventory_mouse.c). Same units as the
+ * original 56..136 bars with 16-step rows; a label's string y is its bar's top
+ * + 112 and its string x is the prim x + 160, exactly as in the original. */
+#define RGDS_CMD_SCALE_Q12  5734 /* 1.4x the original glyphs */
+#define RGDS_CMD_X0         42
+#define RGDS_CMD_X1         146
+#define RGDS_CMD_TEXT_X     48
+#define RGDS_CMD_BAR_HALF   8
+#define RGDS_CMD_STEP       28
+#define RGDS_CMD_Y0_SINGLE  (-148)
+#define RGDS_CMD_Y0_DOUBLE  (-160)
+
+/* Bottom-screen paper map. Floor arrows in prim units of the 320x448 map screen
+ * (centre origin): a little larger than the original 200..216, still outside the
+ * plans, which reach about 197. The close / zoom buttons are square sprites drawn
+ * in the post-capture hook (rgds_map_icons.c), placed in fractions of the
+ * presented 1024x768 picture; their tap zones reach a little past the sprites. */
