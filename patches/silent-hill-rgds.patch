+/* Gameplay keeps the live clip and reserve in playerCombat; the inventory slots
+ * only catch up when the inventory opens (func_800540A4). The bottom menu never
+ * opens it, so the world writes them back itself before showing or using them. */
+static void Pc_AmmoWriteBack(s_Savegame* save)
+{
+    s32 i, weapon = NO_VALUE;
+    u8  id = save->equippedWeapon;
+
+    if (INV_ITEM_GROUP(id) != InvItemGroup_GunWeapons)
+        return;
+    for (i = 0; i < save->inventorySlotCount && i < INV_ITEM_COUNT_MAX; i++)
+        if (save->items[i].id_0 == id) { weapon = i; break; }
+    if (weapon == NO_VALUE)
+        return;
+    save->items[weapon].count_1 = g_SysWork.playerCombat.currentWeaponAmmo;
+    for (i = 0; i < save->inventorySlotCount && i < INV_ITEM_COUNT_MAX; i++)
+        if (save->items[i].id_0 == INV_WEAPON_AMMO_ID(id)) { save->items[i].count_1 = g_SysWork.playerCombat.totalWeaponAmmo; break; }
+}
+
+void Pc_RgdsPublishAmmo(s_Savegame* save)
+{
+    Pc_AmmoWriteBack(save);
+}
