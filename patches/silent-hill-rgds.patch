+/* RG DS bottom menu: the original inventory commands applied to the live world.
+ * Mirrors item_screens_3.c steps 5-9 and Inventory_ItemUse without the menu's
+ * pause; see rgds_native.h for the result codes. */
+int Pc_RgdsItemAction(unsigned char id, int op)
+{
+    s32 slot, group;
+
+    if (!Pc_ActionSafe() || g_SysWork.playerWork.player.health <= 0)
+        return -1;
+    Pc_AmmoWriteBack(g_SavegamePtr);
+    slot = Pc_FindItemSlot(id);
+    if (slot == NO_VALUE)
+        return -2;
+    group = INV_ITEM_GROUP(id);
+
+    switch (op)
+    {
+        case RgDsOp_Equip:
+            if (group != InvItemGroup_MeleeWeapons && group != InvItemGroup_GunWeapons)
+                return 0;
+            if (g_SavegamePtr->equippedWeapon != id)
+                Pc_EquipWeapon(id, slot);
+            return 1;
+
+        case RgDsOp_Unequip:
+            if (g_SavegamePtr->equippedWeapon != id)
+                return 0;
+            func_8004C564(0, NO_VALUE);
+            g_Inventory_EquippedItem = g_SavegamePtr->equippedWeapon = InvItemId_Unequipped;
+            g_SysWork.playerCombat.weaponAttack = NO_VALUE;
+            g_SysWork.playerCombat.weaponInventoryIdx = NO_VALUE;
+            g_SysWork.playerCombat.currentWeaponAmmo = g_SysWork.playerCombat.totalWeaponAmmo = 0;
+            Pc_GasWeaponStop();
+            GameFs_WeaponInfoUpdate();
+            WorldGfx_PlayerPrevHeldItem(&g_SysWork.playerCombat);
+            func_8003D01C();
+            return 1;
+
+        case RgDsOp_Reload:
+        {
+            s32 gun = (group == InvItemGroup_GunAmmo) ? INV_AMMO_WEAPON_ID(id) : id;
+            s32 gunSlot, ammoSlot, clip, ammo;
+
+            if (INV_ITEM_GROUP(gun) != InvItemGroup_GunWeapons || gun == InvItemId_HyperBlaster)
+                return 0;
+            gunSlot  = Pc_FindItemSlot((u8)gun);
+            ammoSlot = Pc_FindItemSlot((u8)INV_WEAPON_AMMO_ID(gun));
+            if (gunSlot == NO_VALUE)
+                return 0;
+            /* The original accepts Reload on a full clip or without a box and
+             * changes nothing (steps 7/8 run with nothing to move). */
+            if (ammoSlot == NO_VALUE || !g_SavegamePtr->items[ammoSlot].count_1)
+                return 1;
+            clip = g_SavegamePtr->items[gunSlot].count_1;
+            ammo = g_SavegamePtr->items[ammoSlot].count_1;
+            Items_AmmoReloadCalculation(&clip, &ammo, (u8)(gun + 0x80));
+            if (clip == g_SavegamePtr->items[gunSlot].count_1)
+                return 1;
+            g_SavegamePtr->items[gunSlot].count_1  = clip;
+            g_SavegamePtr->items[ammoSlot].count_1 = ammo;
+            if (g_SavegamePtr->equippedWeapon == gun)
+            {
+                g_SysWork.playerCombat.currentWeaponAmmo = clip;
+                g_SysWork.playerCombat.totalWeaponAmmo   = ammo;
+            }
+            /* An emptied box leaves the inventory, as in the original reload. */
+            if (!ammo)
+                g_SavegamePtr->inventorySlotCount = func_8004F190(g_SavegamePtr);
+            return 1;
+        }
+
+        case RgDsOp_On:
+        case RgDsOp_Off:
+            if (id == InvItemId_Flashlight)
+            {
+                if (op == RgDsOp_On) Game_TurnFlashlightOn(); else Game_TurnFlashlightOff();
+                return 1;
+            }
+            if (id == InvItemId_PocketRadio)
+            {
+                if (op == RgDsOp_On) g_SavegamePtr->itemToggleFlags |= ItemToggleFlag_RadioOn;
+                else g_SavegamePtr->itemToggleFlags &= ~ItemToggleFlag_RadioOn;
+                return 1;
+            }
+            return 0;
+
+        case RgDsOp_Use:
+            if (id == InvItemId_HealthDrink || id == InvItemId_FirstAidKit || id == InvItemId_Ampoule)
+            {
+                q19_12 health = g_SysWork.playerWork.player.health;
+
+                if (!g_SavegamePtr->items[slot].count_1)
+                    return -2;
+                health += (id == InvItemId_FirstAidKit) ? Q12(80.0f) : (id == InvItemId_HealthDrink) ? Q12(40.0f) : Q12(100.0f);
+                if (id == InvItemId_Ampoule)
+                    g_SavegamePtr->healthSaturation = Q12(300.0f);
+                Sd_PlaySfx(Sfx_Unk1325, -0x40, 0x40);
+                g_SysWork.playerWork.player.health = CLAMP(health, Q12(0.0f), Q12(100.0f));
+                Player_ItemRemove(id, 1);
+                return 1;
+            }
+            {
+                s32 step1 = g_GameWork.gameStateSteps[1], step2 = g_GameWork.gameStateSteps[2];
+                s32 selection = g_Inventory_SelectionId, border = g_Inventory_SelectionBordersDraw, used;
+
+                Inventory_ItemUse(slot);
