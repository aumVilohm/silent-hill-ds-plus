+#define RGDS_MAP_BTN_H      (64.0f / 768.0f)
+#define RGDS_MAP_BTN_Y0     (692.0f / 768.0f)
+#define RGDS_MAP_CLOSE_X0   (12.0f / 1024.0f)
+#define RGDS_MAP_ZOOM_X0    (948.0f / 1024.0f)
+#define RGDS_MAP_HIT_Y0     (660.0f / 768.0f)
+#define RGDS_MAP_HIT_W      (110.0f / 1024.0f)
