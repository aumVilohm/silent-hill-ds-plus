+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef RGDS_NATIVE_H
+#define RGDS_NATIVE_H
+/* Bottom-menu commands applied by the world process (pc_combat.c). */
+enum
+{
+    RgDsOp_None    = 0,
+    RgDsOp_Use     = 1,
+    RgDsOp_Equip   = 2,
+    RgDsOp_Unequip = 3,
+    RgDsOp_Reload  = 4,
+    RgDsOp_On      = 5,
+    RgDsOp_Off     = 6,
+    RgDsOp_Options = 7
