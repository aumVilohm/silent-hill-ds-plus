+    for (slot = 0; slot < g_SavegamePtr->inventorySlotCount && slot < INV_ITEM_COUNT_MAX; slot++) {
+        int id = g_SavegamePtr->items[slot].id_0;
+        if (id >= InvItemId_HealthDrink && id <= InvItemId_GasolineTank && index-- == 0) return slot;
+    }
+    return -1;
+}
+
+static int VisibleCount(void)
+{
+    int count = 0;
+    while (count < INV_ITEM_COUNT_MAX && VisibleSlot(count) >= 0) count++;
+    return count;
+}
+
+static int Hit(int x, int y)
+{
+    int row, column;
+    if (y >= 154 && y < 554 && x >= 24 && x < 1000) {
+        row = (y - 154) / 80;
+        column = (x - 24) / 492;
+        if (column < 2 && (x - 24) % 492 < 478 && (y - 154) % 80 < 70)
+            return row * 2 + column;
+    }
+    if (y >= 636 && y < 714) {
+        if (x >= 24 && x < 492) return 100;
+        if (x >= 508 && x < 1000) return 101;
+    }
+    if (y >= 92 && y < 140) {
+        if (x >= 728 && x < 856) return 102;
+        if (x >= 872 && x < 1000) return 103;
+    }
+    return -1;
+}
+
+static void Activate(int hit)
+{
+    int slot;
+    if (hit >= 0 && hit < 10) {
+        slot = VisibleSlot(s_page * 10 + hit);
+        if (slot >= 0) {
+            s_selectedId = g_SavegamePtr->items[slot].id_0;
+            snprintf(s_status, sizeof(s_status), "Selected: %.64s", ItemName(s_selectedId));
+        }
+    } else if (hit == 100 || hit == 101) {
+        if (s_selectedId >= 0) {
+            s_pendingId = s_selectedId;
+            s_pendingReload = hit == 101;
+        }
+    } else if (hit == 102 && s_page > 0) {
+        s_page--;
+    } else if (hit == 103 && (s_page + 1) * 10 < VisibleCount()) {
+        s_page++;
+    }
+}
+
+static int InventoryEvent(SDL_Event* event)
+{
+    Uint32 id = SDL_GetWindowID(s_window), eventId = 0;
+    int x = 0, y = 0, down = 0, up = 0;
+    switch (event->type) {
+        case SDL_WINDOWEVENT:
+            if (event->window.windowID != id) return 0;
+            if (event->window.event == SDL_WINDOWEVENT_SIZE_CHANGED ||
+                event->window.event == SDL_WINDOWEVENT_EXPOSED)
+                s_surface = NULL;
+            return 1;
+        case SDL_MOUSEBUTTONDOWN:
+        case SDL_MOUSEBUTTONUP:
+            eventId = event->button.windowID;
+            if (eventId != id) return 0;
+            if (event->button.which == SDL_TOUCH_MOUSEID) return 1;
+            x = event->button.x;
+            y = event->button.y;
+            down = event->type == SDL_MOUSEBUTTONDOWN;
+            up = event->type == SDL_MOUSEBUTTONUP;
+            break;
+        case SDL_FINGERDOWN:
+        case SDL_FINGERUP:
+        case SDL_FINGERMOTION:
+        {
+            int width, height;
+            if (event->tfinger.windowID != id) return 0;
+            SDL_GetWindowSize(s_window, &width, &height);
+            x = (int)(event->tfinger.x * width);
+            y = (int)(event->tfinger.y * height);
+            down = event->type == SDL_FINGERDOWN;
+            up = event->type == SDL_FINGERUP;
+            break;
+        }
+        case SDL_MOUSEMOTION:
+            return event->motion.windowID == id;
+        case SDL_MOUSEWHEEL:
+            if (event->wheel.windowID != id) return 0;
+            Activate(event->wheel.y > 0 ? 102 : 103);
+            return 1;
+        default:
+            return 0;
+    }
+    {
+        int width, height, hit;
+        SDL_GetWindowSize(s_window, &width, &height);
+        if (width <= 0 || height <= 0) return 1;
+        hit = Hit(x * 1024 / width, y * 768 / height);
+        if (down) s_pressed = hit;
+        if (up) {
+            if (hit == s_pressed) Activate(hit);
+            s_pressed = -1;
+        }
+    }
+    return 1;
+}
+
+void RgDs_Init(void)
+{
+    int i, display = SDL_GetNumVideoDisplays() > 1 ? 1 : 0;
+    SDL_Window* top;
+    SDL_GLContext context;
+    if (!RgDs_Enabled()) return;
+    if (RgDs_NativeInit()) return;
+    if (getenv("SH_RGDS_ROLE")) {
+        SH_DBG("[RGDS] native inventory bridge failed; stopping this process");
+        if (g_ShDebugLog) fflush(g_ShDebugLog);
+        exit(2);
+    }
+    top = SDL_GL_GetCurrentWindow();
+    context = SDL_GL_GetCurrentContext();
+    for (i = 0; i < SDL_GetNumVideoDisplays(); i++) {
+        const char* name = SDL_GetDisplayName(i);
+        SH_DBG("[RGDS] display %d: %s", i, name ? name : "unknown");
+        if (name && strstr(name, "DSI-1")) display = i;
+    }
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+    /* A second GPU-backed SDL surface can disturb PsyCross's cached GL state. */
+    SDL_SetHint(SDL_HINT_FRAMEBUFFER_ACCELERATION, "0");
+    SDL_SetWindowTitle(g_window, "Silent Hill RGDS [Top]");
+    s_window = SDL_CreateWindow("Silent Hill RGDS [Bottom]", SDL_WINDOWPOS_UNDEFINED_DISPLAY(display),
+                                SDL_WINDOWPOS_UNDEFINED_DISPLAY(display), 1024, 768,
+                                SDL_WINDOW_SHOWN | SDL_WINDOW_BORDERLESS);
+    if (!s_window) {
+        SH_DBG("[RGDS] bottom window failed: %s", SDL_GetError());
+        return;
+    }
+    g_PsyX_EventHook = InventoryEvent;
+    s_wayland = RgDs_WaylandInit(s_window);
+    if (top && context) SDL_GL_MakeCurrent(top, context);
+    SH_DBG("[RGDS] bottom window=%u on display=%d; inventory does not change game state", SDL_GetWindowID(s_window), display);
+}
+
+void RgDs_Update(void)
+{
+    int result, beforeHp, beforeCount, slot;
+    unsigned flags;
+    if (RgDs_NativeActive()) { RgDs_NativeUpdate(); return; }
+    if (!s_window) return;
+    s_frames++;
+    flags = g_Controller0->clickedBtnFlags;
+    if (g_GameWork.gameState == GameState_InGame) {
+        int reference = getenv("SH_RGDS_REFERENCE") != NULL;
+        if (!reference && (flags & ControllerFlag_Select)) s_focus = !s_focus;
+        if (s_focus) {
+            int n = VisibleCount(), selected;
+            for (selected = 0; selected < n; selected++)
+                if (g_SavegamePtr->items[VisibleSlot(selected)].id_0 == s_selectedId) break;
+            if (selected == n) selected = -1;
+            if (n > 0) {
+                if (selected < 0) selected = 0;
+                if (flags & ControllerFlag_LStickDown) selected = (selected + 2) % n;
+                if (flags & ControllerFlag_LStickUp) selected = (selected + n - (2 % n)) % n;
+                if (flags & ControllerFlag_LStickRight) selected = (selected + 1) % n;
+                if (flags & ControllerFlag_LStickLeft) selected = (selected + n - 1) % n;
+                s_selectedId = g_SavegamePtr->items[VisibleSlot(selected)].id_0;
+                s_page = selected / 10;
+                if (flags & ControllerFlag_Cross) Activate(100);
+                if (flags & ControllerFlag_Square) Activate(101);
+            }
+            if (flags & ControllerFlag_Circle) s_focus = 0;
+            g_Controller0->heldBtnFlags = 0;
+            g_Controller0->clickedBtnFlags = 0;
+            g_Controller0->releasedBtnFlags = 0;
+            g_Controller0->pulsedBtnFlags = 0;
+            g_Controller0->pulsedGuiBtnFlags = 0;
+            g_Controller0->sticks_20.rawData_0 = 0;
+            g_Controller0->sticks_24.rawData_0 = 0;
+        }
+        if (!reference) {
+            g_Controller0->heldBtnFlags &= ~ControllerFlag_Select;
+            g_Controller0->clickedBtnFlags &= ~ControllerFlag_Select;
+            g_Controller0->pulsedBtnFlags &= ~ControllerFlag_Select;
+            g_Controller0->pulsedGuiBtnFlags &= ~ControllerFlag_Select;
+        }
+    }
+    if (s_pendingId >= 0) {
+        int id = s_pendingId, reload = s_pendingReload;
+        s_pendingId = -1;
+        slot = SlotForId(id);
+        beforeCount = slot < 0 ? 0 : g_SavegamePtr->items[slot].count_1;
+        beforeHp = g_SysWork.playerWork.player.health;
+        result = Pc_RgdsItemAction((unsigned char)id, reload);
+        snprintf(s_status, sizeof(s_status), "%s: %.55s", result > 0 ? "Applied" : result < 0 ? "Busy - try again" : "Cannot use here", ItemName(id));
+        slot = SlotForId(id);
+        SH_DBG("[RGDS_ACTION] frame=%u item=%d reload=%d result=%d hp=%d->%d count=%d->%d state=%d sys=%d",
+               s_frames, id, reload, result, beforeHp, g_SysWork.playerWork.player.health,
+               beforeCount, slot < 0 ? 0 : g_SavegamePtr->items[slot].count_1,
+               g_GameWork.gameState, g_SysWork.sysState);
+    }
+}
+
+static void Rect(int x, int y, int w, int h, Uint32 color)
+{
+    SDL_Rect rect = { x * s_surface->w / 1024, y * s_surface->h / 768,
+                      w * s_surface->w / 1024, h * s_surface->h / 768 };
+    SDL_FillRect(s_surface, &rect, color);
+}
+
+static void Text(int x, int y, const char* text, int scale, Uint32 color, int maxChars)
+{
+    int n, row, column;
+    for (n = 0; text[n] && n < maxChars; n++) {
+        unsigned char ch = (unsigned char)text[n];
+        const unsigned char* glyph;
+        if (ch == '_') ch = ' ';
+        if (ch < 32 || ch > 126) ch = '?';
+        glyph = DbgOverlay_Glyph(ch);
+        for (row = 0; row < 8; row++)
+            for (column = 0; column < 8; column++)
+                if (glyph[row] & (1 << column))
+                    Rect(x + n * 8 * scale + column * scale, y + row * scale, scale, scale, color);
+    }
+}
+
+void RgDs_Present(void)
+{
+    Uint32 now, bg, card, white, green, muted;
+    int i, hp, selectedSlot, count;
+    char text[100];
+    SDL_Window* top;
+    SDL_GLContext context;
+    if (RgDs_NativeActive()) { RgDs_NativePresent(); return; }
+    if (!s_window) return;
+    now = SDL_GetTicks();
+    if (s_lastPresent && now - s_lastPresent < 100) return;
+    s_lastPresent = now;
+    top = SDL_GL_GetCurrentWindow();
+    context = SDL_GL_GetCurrentContext();
+    if (s_wayland) s_surface = RgDs_WaylandBegin();
+    else if (!s_surface) s_surface = SDL_GetWindowSurface(s_window);
+    if (!s_surface) {
+        if (now - s_lastTrace > 3000) {
+            SH_DBG("[RGDS] bottom surface unavailable: %s", SDL_GetError());
+            s_lastTrace = now;
+        }
+        if (top && context) SDL_GL_MakeCurrent(top, context);
+        return;
+    }
+    bg = SDL_MapRGB(s_surface->format, 14, 19, 19);
+    card = SDL_MapRGB(s_surface->format, 30, 40, 39);
+    white = SDL_MapRGB(s_surface->format, 228, 232, 215);
+    green = SDL_MapRGB(s_surface->format, 130, 188, 139);
+    muted = SDL_MapRGB(s_surface->format, 133, 145, 132);
+    SDL_FillRect(s_surface, NULL, bg);
+    Text(24, 22, "SILENT HILL / INVENTORY", 3, white, 40);
+    hp = g_SysWork.playerWork.player.health >> Q12_SHIFT;
+    if (hp < 0) hp = 0;
+    if (hp > 100) hp = 100;
+    snprintf(text, sizeof(text), "HP %3d   %s   FRAME %u", hp, s_focus ? "INVENTORY CONTROLS" : "LIVE", s_frames);
+    Text(24, 62, text, 2, green, 60);
+    Rect(24, 96, 650, 12, card);
+    Rect(24, 96, hp * 650 / 100, 12, green);
+    Text(24, 122, "WORLD CONTINUES WHILE YOU USE ITEMS", 2, muted, 47);
+    Rect(728, 92, 128, 48, card);
+    Rect(872, 92, 128, 48, card);
+    Text(746, 108, "< PREV", 2, white, 7);
+    Text(890, 108, "NEXT >", 2, white, 7);
+    count = VisibleCount();
+    if (s_page * 10 >= count) s_page = 0;
+    for (i = 0; i < 10; i++) {
+        int slot = VisibleSlot(s_page * 10 + i);
+        int x = 24 + (i % 2) * 492, y = 154 + (i / 2) * 80;
+        int id;
+        if (slot < 0) break;
+        id = g_SavegamePtr->items[slot].id_0;
+        Rect(x, y, 478, 70, id == s_selectedId ? green : card);
+        Text(x + 12, y + 10, ItemName(id), 2, id == s_selectedId ? bg : white, 28);
+        snprintf(text, sizeof(text), "COUNT %u%s", g_SavegamePtr->items[slot].count_1,
+                 id == g_SavegamePtr->equippedWeapon ? "   EQUIPPED" : "");
+        Text(x + 12, y + 40, text, 2, id == s_selectedId ? bg : muted, 28);
+    }
+    if (count == 0) Text(24, 200, "No items yet. Start or load a game above.", 2, muted, 60);
+    selectedSlot = SlotForId(s_selectedId);
+    Text(24, 572, s_status, 2, white, 60);
+    snprintf(text, sizeof(text), "PAGE %d   ITEMS %d   %s", s_page + 1, count,
+             g_GameWork.gameState == GameState_InGame ? "GAMEPLAY" : "WAITING FOR GAMEPLAY");
+    Text(24, 606, text, 2, muted, 60);
+    Rect(24, 636, 468, 78, selectedSlot >= 0 ? green : card);
+    Rect(508, 636, 492, 78, card);
+    Text(70, 662, "USE / EQUIP / TOGGLE", 2, selectedSlot >= 0 ? bg : muted, 24);
+    Text(630, 662, "RELOAD", 3, white, 12);
+    Text(24, 738, "SELECT: controls  A: use  X: reload  B: back", 2, muted, 60);
+    {
+        int result = s_wayland ? RgDs_WaylandCommit() : SDL_UpdateWindowSurface(s_window);
+        static int reported;
+        if (!reported || result < 0) {
+            SH_DBG("[RGDS_SURFACE] %dx%d format=%s update=%d error=%s top=%u context=%p", s_surface->w, s_surface->h,
+                   SDL_GetPixelFormatName(s_surface->format->format), result, result < 0 ? SDL_GetError() : "none",
+                   top ? SDL_GetWindowID(top) : 0, context);
+            reported = 1;
+        }
+    }
+    if (top && context && SDL_GL_MakeCurrent(top, context) < 0)
+        SH_DBG("[RGDS] restore GL context failed: %s", SDL_GetError());
+    if (now - s_lastTrace >= 3000) {
+        SH_DBG("[RGDS_LIVE] frame=%u state=%d sys=%d hp=%d items=%d selected=%d focus=%d time=%d weapon=%d toggles=%d",
+               s_frames, g_GameWork.gameState, g_SysWork.sysState, hp, count, s_selectedId, s_focus,
+               g_SavegamePtr->gameplayTimer, g_SavegamePtr->equippedWeapon, g_SavegamePtr->itemToggleFlags);
+        s_lastTrace = now;
+    }
+}
diff --git a/pc_port/src/rgds_native.c b/pc_port/src/rgds_native.c
new file mode 100644
index 0000000..68d99fc
--- /dev/null
+++ b/pc_port/src/rgds_native.c
@@ -0,0 +1,956 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "rgds_native.h"
+#if defined(SH_RGDS) && defined(__linux__)
+#include <SDL2/SDL.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <stdio.h>
+#include <errno.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <signal.h>
+#include "game.h"
+#include "bodyprog/bodyprog.h"
+#include "bodyprog/item_screens.h"
+#include "bodyprog/player.h"
+#include "bodyprog/sound/sound_system.h"
+#include "map_registry.h"
+#include "pc_config.h"
+#include "bodyprog/math/math.h"
+#include "bodyprog/screen/screen_data.h"
+#include "bodyprog/screen/screen_fade.h"
+#include "bodyprog/text/text_draw.h"
+#include "lang_text.h"
+#include "pc_mouse_cursor.h"
+#include "sh_log.h"
+
+extern SDL_Window* g_window;
+extern int Pc_RgdsItemAction(unsigned char id, int operation);
+extern void Pc_RgdsPublishAmmo(s_Savegame* save);
+
+#define RGDS_BRIDGE_VERSION    2
+#define RGDS_SFX_RING          16
+#define RGDS_REQUEST_EXPIRY_MS 1500
+
+typedef struct {
+    s32 posX, posY, posZ, rotY;
+    u8  flashlightOn, flashlightUnavailable, darkness, light0, light1;
+    u8  mapRequest; /* bumped by the world: open the map on the bottom screen */
+    u8  pad[2];
+} RgdsWorld;
+
+typedef struct {
+    _Atomic unsigned sequence, request, acknowledged, focus;
+    _Atomic unsigned quit, sfxWrite, sfxRead;
+    unsigned parentHeld, workerFrames, version;
+    _Atomic unsigned workerState;
+    int parentPid, hp, gameState, sysState, result, item, operation;
+    s_Savegame save;
+    RgdsWorld world;
+    unsigned requestTime;
+    unsigned sfx[RGDS_SFX_RING];
+} NativeBridge;
+/* Both processes share this layout; keep the offsets stable. */
+_Static_assert(sizeof(unsigned) == 4 && offsetof(NativeBridge, save) == 72 &&
+               offsetof(NativeBridge, world) == 708 && offsetof(NativeBridge, requestTime) == 732 &&
+               offsetof(NativeBridge, sfx) == 736 && sizeof(NativeBridge) == 800, "RGDS shared-state ABI changed");
+
+static NativeBridge* s_bridge;
+static int s_worker, s_opened, s_loadedMap = -1;
+/* Bottom-screen Exit question (drawn with the inventory's own bars and font). */
+static int s_exitAsk, s_exitYes;
+static unsigned s_exitAskSince;
+/* Map button in the world -> the original map on the bottom screen. */
+static u8 s_mapRequests, s_mapSeen;
+static int s_mapSeenValid, s_mapFromWorld, s_mapShown;
+static unsigned s_mapAskedAt, s_mapPrevSelection, s_mapWaitSince;
+static unsigned s_frames, s_lastTrace;
+static unsigned s_parentFocus, s_parentSuppress, s_workerFocus, s_workerSuppress;
+static unsigned s_pending, s_pendingOp, s_pendingSince, s_quitSince;
+static Uint64 s_lastPresent;
+static _Atomic unsigned s_lastInput, s_tapPending;
+static _Atomic int s_tapX, s_tapY;
+static int s_menuFps = 60, s_idleFps = 30;
+
+static unsigned NowMs(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (unsigned)(now.tv_sec * 1000u + now.tv_nsec / 1000000);
+}
+
+int RgDs_NativeActive(void) { return s_bridge != NULL; }
+int RgDs_NativeIsMenuProcess(void) { return s_bridge != NULL && s_worker; }
+int RgDs_NativeMenuReady(void) { return s_bridge != NULL && s_worker && s_opened; }
+int RgDs_NativeInputFocus(void) { return s_bridge && (s_worker || atomic_load(&s_bridge->focus)); }
+
+/* Only the bottom process watches: SDL's polled mouse state never shows a tap that
+ * starts and ends between two frames, and touch is the bottom screen's main input. */
+static int SDLCALL WorkerEventWatch(void* data, SDL_Event* event)
+{
+    (void)data;
+    switch (event->type)
+    {
+        case SDL_MOUSEBUTTONDOWN:
+            if (event->button.button == SDL_BUTTON_LEFT)
+            {
+                atomic_store(&s_tapX, event->button.x);
+                atomic_store(&s_tapY, event->button.y);
+                atomic_store(&s_tapPending, 1);
+            }
+            /* fall through */
+        case SDL_MOUSEBUTTONUP:
+        case SDL_MOUSEMOTION:
+        case SDL_FINGERDOWN:
+        case SDL_FINGERUP:
+        case SDL_FINGERMOTION:
+            atomic_store(&s_lastInput, NowMs());
+            break;
+        case SDL_CONTROLLERBUTTONDOWN:
+        case SDL_CONTROLLERAXISMOTION:
+            if (s_bridge && atomic_load(&s_bridge->focus))
+                atomic_store(&s_lastInput, NowMs());
+            break;
+    }
+    return 1;
+}
+
+static int EnvInt(const char* name, int fallback, int low, int high)
+{
+    const char* value = getenv(name);
+    int number;
+    if (!value || !*value) return fallback;
+    number = atoi(value);
+    return number < low ? low : number > high ? high : number;
+}
+
+int RgDs_NativeInit(void)
+{
+    const char* role = getenv("SH_RGDS_ROLE");
+    const char* path = getenv("SH_RGDS_BRIDGE");
+    int fd, i;
+    FILE* file = NULL;
+    if (!role || !path) return 0;
+    s_worker = !strcmp(role, "inventory");
+    /* PsyCross defines open/close for PS1 memory cards, even on Linux. */
+    for (i = 0; i < 300 && !file; i++) {
+        file = fopen(path, s_worker ? "r+b" : "w+b");
+        if (file && s_worker) {
+            struct stat info;
+            if (fstat(fileno(file), &info) < 0 || info.st_size < (off_t)sizeof(NativeBridge)) {
+                fclose(file);
+                file = NULL;
+            }
+        }
+        if (!file && s_worker) SDL_Delay(50);
+        else if (!file) break;
+    }
+    if (!file) { SH_DBG("[RGDS_NATIVE] cannot open bridge: %s", strerror(errno)); return 0; }
+    fd = fileno(file);
+    if (!s_worker && (fchmod(fd, 0600) < 0 || ftruncate(fd, sizeof(NativeBridge)) < 0)) { fclose(file); return 0; }
+    s_bridge = mmap(NULL, sizeof(NativeBridge), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    fclose(file);
+    if (s_bridge == MAP_FAILED) { s_bridge = NULL; return 0; }
+    if (!s_worker) {
+        memset(s_bridge, 0, sizeof(*s_bridge));
+        s_bridge->parentPid = getpid();
+        s_bridge->version = RGDS_BRIDGE_VERSION;
+    } else if (s_bridge->version != RGDS_BRIDGE_VERSION) {
+        SH_DBG("[RGDS_NATIVE] bridge version %u, expected %u", s_bridge->version, RGDS_BRIDGE_VERSION);
+        munmap(s_bridge, sizeof(NativeBridge));
+        s_bridge = NULL;
+        return 0;
+    }
+    if (s_worker) {
+        s_menuFps = EnvInt("SH_RGDS_MENU_FPS", 60, 15, 60);
+        s_idleFps = EnvInt("SH_RGDS_MENU_IDLE_FPS", 30, 5, s_menuFps);
+        SDL_AddEventWatch(WorkerEventWatch, NULL);
+    }
+    SDL_SetWindowTitle(g_window, s_worker ? "Silent Hill RGDS [Bottom]" : "Silent Hill RGDS [Top]");
+    SH_DBG("[RGDS_NATIVE] role=%s pid=%d abi=%d menu_fps=%d idle_fps=%d; original menu renderer, shared live state",
+           role, (int)getpid(), RGDS_BRIDGE_VERSION, s_menuFps, s_idleFps);
+    return 1;
+}
+
+/* Joy_ControllerDataUpdate derives the next click edges from last frame's
+ * heldBtnFlags. Clearing or stripping them here made a held Select read as a fresh
+ * click every frame (the focus flipped back and forth for as long as it was held),
+ * so the real value is put back before the next update, as the quick-options
+ * overlay does with s_pcQoHeldStash. */
+static unsigned s_realHeld;
+static int s_realHeldValid;
+
+void RgDs_NativeRestoreHeld(void)
+{
+    if (!s_realHeldValid) return;
+    g_Controller0->heldBtnFlags = s_realHeld;
+    s_realHeldValid = 0;
+}
+
+static void ClearPad(void)
+{
+    g_Controller0->heldBtnFlags = g_Controller0->clickedBtnFlags = g_Controller0->releasedBtnFlags = 0;
+    g_Controller0->pulsedBtnFlags = g_Controller0->pulsedGuiBtnFlags = 0;
+    g_Controller0->sticks_20.rawData_0 = g_Controller0->sticks_24.rawData_0 = 0;
+}
+
+static void StripPad(unsigned mask)
+{
+    g_Controller0->heldBtnFlags &= ~mask;
+    g_Controller0->clickedBtnFlags &= ~mask;
+    g_Controller0->releasedBtnFlags &= ~mask;
+    g_Controller0->pulsedBtnFlags &= ~mask;
+    g_Controller0->pulsedGuiBtnFlags &= ~mask;
+}
+
+/* Both processes read the same physical pad. A button still held when focus moves
+ * belongs to the screen that had it, so the other side ignores it until release. */
+static unsigned SuppressHeld(unsigned* suppress, unsigned* lastFocus, unsigned focus, unsigned mine)
+{
+    if (focus != *lastFocus) {
+        *suppress = g_Controller0->heldBtnFlags;
+        *lastFocus = focus;
+    }
+    *suppress &= g_Controller0->heldBtnFlags;
+    if (focus == mine) StripPad(*suppress);
+    return *suppress;
+}
+
+static void PublishWorld(void)
+{
+    RgdsWorld* world = &s_bridge->world;
+    world->posX = g_SysWork.playerWork.player.position.vx;
+    world->posY = g_SysWork.playerWork.player.position.vy;
+    world->posZ = g_SysWork.playerWork.player.position.vz;
+    world->rotY = g_SysWork.playerWork.player.rotation.vy;
+    world->flashlightOn = g_SysWork.field_2388.isFlashlightOn_15;
+    world->flashlightUnavailable = g_SysWork.field_2388.isFlashlightUnavailable_16;
+    world->darkness = g_SysWork.field_2388.field_154.effectsInfo_0.field_0.s_field_0.field_0;
+    world->light0 = g_SysWork.field_2388.field_1C[0].effectsInfo_0.field_0.s_field_0.field_0;
+    world->light1 = g_SysWork.field_2388.field_1C[1].effectsInfo_0.field_0.s_field_0.field_0;
+    world->mapRequest = s_mapRequests;
+}
+
+static void ApplyWorld(const RgdsWorld* world)
+{
+    g_SysWork.playerWork.player.position.vx = world->posX;
+    g_SysWork.playerWork.player.position.vy = world->posY;
+    g_SysWork.playerWork.player.position.vz = world->posZ;
+    g_SysWork.playerWork.player.rotation.vy = world->rotY;
+    g_SysWork.field_2388.isFlashlightOn_15 = world->flashlightOn;
+    g_SysWork.field_2388.isFlashlightUnavailable_16 = world->flashlightUnavailable;
+    g_SysWork.field_2388.field_154.effectsInfo_0.field_0.s_field_0.field_0 = world->darkness;
+    g_SysWork.field_2388.field_1C[0].effectsInfo_0.field_0.s_field_0.field_0 = world->light0;
+    g_SysWork.field_2388.field_1C[1].effectsInfo_0.field_0.s_field_0.field_0 = world->light1;
+}
+
+static int ParentOpenOptions(void)
+{
+    if (g_GameWork.gameState != GameState_InGame || g_SysWork.sysState != SysState_Gameplay ||
+        g_Player_DisableControl || Player_IsAttacking() == true)
+        return -1;
+    /* The same transition the original "option" button takes from gameplay. */
+    SysWork_StateSetNext(SysState_OptionsMenu);
+    atomic_store(&s_bridge->focus, 0);
+    return 1;
+}
+
+/* rgds_boot_console: a test start (e.g. "givemap all" in a mid-game scene) without
+ * a keyboard for the PC console. Once, on the first gameplay frame of the world. */
+static void ParentBootConsole(void)
+{
+    static int done;
+    extern void Pc_ConsoleExec(const char* line);
+    char line[sizeof(g_PcConfig.rgdsBootConsole)];
+    char* part;
+    char* next;
+    size_t i;
+
+    if (done || !g_PcConfig.rgdsBootConsole[0] || g_GameWork.gameState != GameState_InGame ||
+        g_SysWork.sysState != SysState_Gameplay)
+        return;
+    done = 1;
+    for (i = 0; i < sizeof(line) - 1 && g_PcConfig.rgdsBootConsole[i]; i++)
+        line[i] = (char)toupper((unsigned char)g_PcConfig.rgdsBootConsole[i]);
+    line[i] = '\0';
+    for (part = line; part; part = next) {
+        next = strchr(part, ';');
+        if (next) *next++ = '\0';
+        while (*part == ' ') part++;
+        if (*part) {
+            SH_DBG("[RGDS_NATIVE] boot console: %s", part);
+            Pc_ConsoleExec(part);
+        }
+    }
+}
+
+static void ParentUpdate(void)
+{
+    unsigned request = atomic_load_explicit(&s_bridge->request, memory_order_acquire);
+    unsigned focus, read, write;
+
+    if (atomic_load(&s_bridge->quit)) {
+        SH_DBG("[RGDS_NATIVE] Exit confirmed on the bottom screen; closing both processes");
+        unlink(getenv("SH_RGDS_BRIDGE"));
+        if (g_ShDebugLog) fflush(g_ShDebugLog);
+        exit(0);
+    }
+    if (request != atomic_load(&s_bridge->acknowledged)) {
+        int item = s_bridge->item, op = s_bridge->operation;
+        int before = g_SysWork.playerWork.player.health;
+        int weapon = g_SavegamePtr->equippedWeapon, toggles = g_SavegamePtr->itemToggleFlags;
+        unsigned age = NowMs() - s_bridge->requestTime;
+        if (age > RGDS_REQUEST_EXPIRY_MS) s_bridge->result = -1;
+        else if (op == RgDsOp_Options) s_bridge->result = ParentOpenOptions();
+        else s_bridge->result = Pc_RgdsItemAction(item, op);
+        SH_DBG("[RGDS_NATIVE_ACTION] request=%u item=%d op=%d result=%d age=%ums hp=%d->%d weapon=%d->%d toggles=%d->%d state=%d sys=%d time=%d",
+               request, item, op, s_bridge->result, age, before, g_SysWork.playerWork.player.health, weapon,
+               g_SavegamePtr->equippedWeapon, toggles, g_SavegamePtr->itemToggleFlags,
+               g_GameWork.gameState, g_SysWork.sysState, g_SavegamePtr->gameplayTimer);
+        atomic_store_explicit(&s_bridge->acknowledged, request, memory_order_release);
+    }
+
+    write = atomic_load_explicit(&s_bridge->sfxWrite, memory_order_acquire);
+    for (read = atomic_load(&s_bridge->sfxRead); read != write; read++) {
+        unsigned sfx = s_bridge->sfx[read % RGDS_SFX_RING];
+        Sd_PlaySfx((u16)(sfx & 0xFFFF), (s8)((sfx >> 16) & 0xFF), (u8)(sfx >> 24));
+    }
+    atomic_store_explicit(&s_bridge->sfxRead, write, memory_order_release);
+
+    ParentBootConsole();
+    s_bridge->parentHeld = g_Controller0->heldBtnFlags;
+    if (g_GameWork.gameState == GameState_InGame) {
+        if (g_Controller0->clickedBtnFlags & ControllerFlag_Select)
+            SH_DBG("[RGDS_NATIVE_FOCUS] Select: pad now drives the %s",
+                   atomic_fetch_xor(&s_bridge->focus, 1) ? "world" : "bottom menu");
+        StripPad(ControllerFlag_Select);
+        focus = atomic_load(&s_bridge->focus);
+        if (!focus && g_PcConfig.rgdsMapBottom && g_SysWork.sysState == SysState_Gameplay &&
+            (g_Controller0->clickedBtnFlags & g_GameWorkPtr->config.controllerConfig.map)) {
+            /* RG DS: the map button shows the original map on the bottom screen in
+             * place of the inventory instead of pausing the world on the top one.
+             * Only when the bottom menu sits in its inventory; otherwise the
+             * original top-screen map runs as before. */
+            unsigned worker = atomic_load(&s_bridge->workerState);
+            int      state  = (int)(worker >> 24);
+            if (state == GameState_InventoryScreen || state == GameState_PaperMapScreen) {
+                /* Opens the map from the inventory, closes it from the map; the
+                 * bottom process ignores it mid-transition. The pad stays with
+                 * Harry, so he keeps walking while the map follows him. */
+                StripPad(g_GameWorkPtr->config.controllerConfig.map);
+                s_mapRequests++;
+                SH_DBG("[RGDS_NATIVE_MAP] map button on the bottom screen (request %u, bottom state %d)", s_mapRequests, state);
+            }
+        }
+        SuppressHeld(&s_parentSuppress, &s_parentFocus, focus, 0);
+        if (focus) {
+            /* Start stays the world's pause (and unpause) whichever screen the
+             * pad drives; the bottom menu has no use for it. */
+            unsigned pause = g_Controller0->clickedBtnFlags & g_GameWorkPtr->config.controllerConfig.pause & ControllerFlag_Start;
+            ClearPad();
+            if (g_SysWork.sysState == SysState_Gameplay || g_SysWork.sysState == SysState_GamePaused)
+                g_Controller0->clickedBtnFlags = pause;
+        }
+    }
+
+    atomic_fetch_add_explicit(&s_bridge->sequence, 1, memory_order_acq_rel);
+    s_bridge->save = *g_SavegamePtr;
+    Pc_RgdsPublishAmmo(&s_bridge->save);
+    s_bridge->hp = g_SysWork.playerWork.player.health;
+    s_bridge->gameState = g_GameWork.gameState;
+    s_bridge->sysState = g_SysWork.sysState;
+    PublishWorld();
+    atomic_fetch_add_explicit(&s_bridge->sequence, 1, memory_order_release);
+}
+
+static void SyncCombatFromSave(void)
+{
+    int i;
+    g_Inventory_EquippedItem = g_SavegamePtr->equippedWeapon;
+    g_SysWork.playerCombat.weaponAttack = g_SavegamePtr->equippedWeapon ? g_SavegamePtr->equippedWeapon + 0x80 : NO_VALUE;
+    g_SysWork.playerCombat.weaponInventoryIdx = NO_VALUE;
+    for (i = 0; i < g_SavegamePtr->inventorySlotCount; i++)
+        if (g_SavegamePtr->items[i].id_0 == g_SavegamePtr->equippedWeapon) {
+            g_SysWork.playerCombat.weaponInventoryIdx = i;
+            g_SysWork.playerCombat.currentWeaponAmmo = g_SavegamePtr->items[i].count_1;
+        }
+    for (i = 0; i < g_SavegamePtr->inventorySlotCount; i++)
+        if (g_SavegamePtr->items[i].id_0 == g_SavegamePtr->equippedWeapon + 32)
+            g_SysWork.playerCombat.totalWeaponAmmo = g_SavegamePtr->items[i].count_1;
+}
+
+static void LoadMenuResources(int mapIdx)
+{
+    MapRegistry_Load(mapIdx);
+    GameFs_Tim00TIMLoad();
+    GameFs_MapItemsModelLoad(mapIdx);
+    Fs_QueueWaitForEmpty();
+    s_loadedMap = mapIdx;
+}
+
+static int ReadSnapshot(s_Savegame* save, int* hp, RgdsWorld* world, int* gameState)
+{
+    int attempt;
+    for (attempt = 0; attempt < 8; attempt++) {
+        unsigned a = atomic_load_explicit(&s_bridge->sequence, memory_order_acquire);
+        if (a & 1) continue;
+        *save = s_bridge->save;
+        *hp = s_bridge->hp;
+        *world = s_bridge->world;
+        *gameState = s_bridge->gameState;
+        atomic_thread_fence(memory_order_acquire);
+        if (a == atomic_load_explicit(&s_bridge->sequence, memory_order_acquire)) return 1;
+    }
+    return 0;
+}
+
+static void ForwardSfx(u16 id, s32 balance, u8 vol);
+
+static void FinishCommand(int result)
+{
+    s_pending = 0;
+    if (s_pendingOp == RgDsOp_Options) {
+        ForwardSfx(result > 0 ? Sfx_MenuConfirm : Sfx_MenuError, 64, 64);
+        return;
+    }
+    g_Inventory_SelectionId = InventorySelectionId_Item;
+    g_Inventory_SelectionBordersDraw = 1;
+    g_Inventory_CmdSelectedIdx = 0;
+    if (result > 0) {
+        ForwardSfx(Sfx_MenuConfirm, 64, 64);
+        return;
+    }
+    ForwardSfx(Sfx_MenuError, 64, 64);
+    /* 3 is the original "Can't use it here." line; 5 is the RG DS busy line. */
+    SysWork_StateStepSet(1, result == 0 && s_pendingOp == RgDsOp_Use ? 3 : 5);
+}
+
+static void WorkerUpdate(void)
+{
+    s_Savegame save;
+    RgdsWorld world;
+    int hp = 0, parentState = 0, valid;
+    unsigned focus;
+
+    if (s_bridge->parentPid && kill(s_bridge->parentPid, 0) < 0) exit(0);
+    s_bridge->workerFrames++;
+    if (atomic_load(&s_bridge->quit)) {
+        /* The world closes itself; a parent the launcher has not reaped yet still
+         * answers kill(0), so do not wait for it forever. */
+        if (!s_quitSince) s_quitSince = NowMs();
+        else if (NowMs() - s_quitSince > 3000) exit(0);
+        ClearPad();
+        return;
+    }
+
+    focus = atomic_load(&s_bridge->focus);
+    if (!focus) ClearPad();
+    StripPad(ControllerFlag_Select | ControllerFlag_Start);
+    SuppressHeld(&s_workerSuppress, &s_workerFocus, focus, 1);
+
+    if (!s_opened && g_GameWork.gameState == GameState_MainMenu &&
+        ReadSnapshot(&save, &hp, &world, &parentState) &&
+        save.inventorySlotCount >= 8 && parentState == GameState_InGame) {
+        *g_SavegamePtr = save;
+        g_SysWork.playerWork.player.health = hp;
+        ApplyWorld(&world);
+        LoadMenuResources(g_SavegamePtr->mapIdx);
+        SyncCombatFromSave();
+        Game_StateSetNext_ClearStateSteps(GameState_LoadStatusScreen);
+        SH_DBG("[RGDS_NATIVE] opening original menu for map %d without loading a second world", s_loadedMap);
+    }
+    if (!s_opened && g_GameWork.gameState == GameState_MainMenu) {
+        /* Wait at the title until the authoritative world has a valid save. Idling
+         * there starts the intro movie or an attract demo, which would load a whole
+         * second world on this 1 GB device; pin the idle counter like the title
+         * does under the achievements panel. */
+        g_PcConfig.skipIntros = 1;
+        g_PcConfig.attractDemos = 0;
+        g_SysWork.counters_1C[1] = 0;
+    }
+    if (!s_opened && g_GameWork.gameState == GameState_InGame && g_SysWork.sysState == SysState_Gameplay) {
+        g_Controller0->clickedBtnFlags |= ControllerFlag_Select;
+        g_Controller0->heldBtnFlags |= ControllerFlag_Select;
+    }
+    if (g_GameWork.gameState == GameState_InventoryScreen) s_opened = 1;
+    atomic_store(&s_bridge->workerState, (unsigned)(g_GameWork.gameState & 0xFF) << 24 |
+                 (unsigned)(g_GameWork.gameStateSteps[1] & 0xFF) << 16 | (unsigned)(g_Inventory_SelectionId & 0xFF) << 8 |
+                 (g_SysWork.invItemSelectedIdx >= 0 && g_SysWork.invItemSelectedIdx < INV_ITEM_COUNT_MAX ?
+                  g_SavegamePtr->items[g_SysWork.invItemSelectedIdx].id_0 : 0xFF));
+    if (!s_opened) return;
+
+    if (s_pending) {
+        if (atomic_load_explicit(&s_bridge->acknowledged, memory_order_acquire) == s_pending)
+            FinishCommand(s_bridge->result);
+        else if (NowMs() - s_pendingSince > RGDS_REQUEST_EXPIRY_MS + 500)
+            FinishCommand(-1);
+    }
+
+    valid = ReadSnapshot(&save, &hp, &world, &parentState);
+    if (!valid || save.inventorySlotCount < 8) return;
+
+    if (!s_mapSeenValid) {
+        s_mapSeen = world.mapRequest;
+        s_mapSeenValid = 1;
+    }
+    if (world.mapRequest != s_mapSeen) {
+        /* The world's map button: the same as choosing Map here, so the original
+         * checks (no paper map, too dark) and the original map screen apply; on
+         * the open map it closes it, as the original map button does. A press that
+         * arrives mid-transition (the map still opening, a floor change, the
+         * inventory taking over) waits for the screen to take input instead of
+         * being lost, up to a second. */
+        int onMap = g_GameWork.gameState == GameState_PaperMapScreen && g_GameWork.gameStateSteps[0] == 2;
+        int inInventory = g_GameWork.gameState == GameState_InventoryScreen && g_GameWork.gameStateSteps[1] == 1 &&
+                          ScreenFade_IsNone() && !s_exitAsk && !s_pending;
+        if (!s_mapWaitSince)
+            s_mapWaitSince = NowMs() | 1;
+        if (onMap || inInventory || NowMs() - s_mapWaitSince > 1000) {
+            s_mapSeen = world.mapRequest;
+            s_mapWaitSince = 0;
+        }
+        if (s_mapWaitSince) {
+            /* Still waiting. */
+        } else if (onMap) {
+            g_Controller0->clickedBtnFlags |= g_GameWorkPtr->config.controllerConfig.cancel;
+        } else if (inInventory) {
+            if (!s_mapFromWorld) /* reopened before the last close restored it */
+                s_mapPrevSelection = g_Inventory_SelectionId;
+            g_Inventory_SelectionId = InventorySelectionId_Map;
+            g_Inventory_PrevSelectionId = InventorySelectionId_Map;
+            g_Inventory_SelectionBordersDraw = 8;
+            g_Inventory_CmdSelectedIdx = 0;
+            g_Controller0->clickedBtnFlags |= g_GameWorkPtr->config.controllerConfig.enter;
+            s_mapFromWorld = 1;
+            s_mapShown = 0;
+            s_mapAskedAt = NowMs();
+        }
+    }
+    if (s_mapFromWorld) {
+        if (g_GameWork.gameState == GameState_PaperMapScreen) {
+            s_mapShown = 1;
+        } else if (g_GameWork.gameState == GameState_InventoryScreen && g_GameWork.gameStateSteps[1] == 1 &&
+                   (s_mapShown || NowMs() - s_mapAskedAt > 400)) {
+            /* Back in the inventory (or the original refused: no map, too dark):
+             * the inventory looks as it did before the button. */
+            g_Inventory_SelectionId = s_mapPrevSelection;
+            g_Inventory_PrevSelectionId = s_mapPrevSelection;
+            g_Inventory_SelectionBordersDraw = 8;
+            s_mapFromWorld = 0;
+            SH_DBG("[RGDS_NATIVE_MAP] %s", s_mapShown ? "map closed" : "map refused");
+        }
+    }
+
+    if (g_GameWork.gameState == GameState_PaperMapScreen) {
+        /* The original map has no pointer support. Touch buttons, each the
+         * original's own input: the floor arrows (up/down), the close button
+         * (cancel) and the zoom button (enter). A tap elsewhere does nothing. */
+        float vx, vy;
+        ApplyWorld(&world);
+        if (g_GameWork.gameStateSteps[0] == 2 && Pc_MouseCursor_LeftClicked() && Pc_MouseCursor_ViewportPos(&vx, &vy)) {
+            float x = vx * 320.0f - 160.0f, y = vy * 448.0f - 224.0f;
+            if (vy >= RGDS_MAP_HIT_Y0 && vx <= RGDS_MAP_HIT_W)
+                g_Controller0->clickedBtnFlags |= g_GameWorkPtr->config.controllerConfig.cancel;
+            else if (vy >= RGDS_MAP_HIT_Y0 && vx >= 1.0f - RGDS_MAP_HIT_W)
+                g_Controller0->clickedBtnFlags |= g_GameWorkPtr->config.controllerConfig.enter;
+            else if (x >= -RGDS_MAP_ARROW_HALF - 22 && x <= RGDS_MAP_ARROW_HALF + 22 && y <= -RGDS_MAP_ARROW_BASE + 11)
+                g_Controller0->clickedBtnFlags |= ControllerFlag_LStickUp;
+            else if (x >= -RGDS_MAP_ARROW_HALF - 22 && x <= RGDS_MAP_ARROW_HALF + 22 && y >= RGDS_MAP_ARROW_BASE - 11)
+                g_Controller0->clickedBtnFlags |= ControllerFlag_LStickDown;
+        }
+        return;
+    }
+    if (g_GameWork.gameState == GameState_InventoryScreen && g_GameWork.gameStateSteps[1] == 14) {
+        /* The original item view (Look) closes on action or cancel only. */
+        if (Pc_MouseCursor_LeftClicked())
+            g_Controller0->clickedBtnFlags |= g_GameWorkPtr->config.controllerConfig.cancel;
+        return;
+    }
+    if (g_GameWork.gameState != GameState_InventoryScreen || g_GameWork.gameStateSteps[1] != 1 || s_exitAsk)
+        return;
+
+    ApplyWorld(&world);
+    if (save.mapIdx != s_loadedMap) {
+        /* The world moved to another map: reload this map's item models and
+         * re-enter through the original status-screen loader. */
+        func_8004C040();
+        *g_SavegamePtr = save;
+        g_SysWork.playerWork.player.health = hp;
+        LoadMenuResources(save.mapIdx);
+        SyncCombatFromSave();
+        Game_StateSetNext_ClearStateSteps(GameState_LoadStatusScreen);
+        SH_DBG("[RGDS_NATIVE] world changed map; menu resources reloaded for map %d", s_loadedMap);
+        return;
+    }
+    {
+        int changed = g_SavegamePtr->equippedWeapon != save.equippedWeapon;
+        int i;
+        for (i = 0; i < INV_ITEM_COUNT_MAX; i++)
+            if (g_SavegamePtr->items[i].id_0 != save.items[i].id_0) changed = 1;
+        *g_SavegamePtr = save;
+        g_SysWork.playerWork.player.health = hp;
+        SyncCombatFromSave();
+        func_8004EF48();
+        if (changed) { func_8004C040(); Gfx_Items_Draw(); SH_DBG("[RGDS_NATIVE] refreshed original item models from live inventory"); }
+    }
+}
+
+void RgDs_NativeUpdate(void)
+{
+    s_frames++;
+    s_realHeld = g_Controller0->heldBtnFlags;
+    s_realHeldValid = 1;
+    if (s_worker) WorkerUpdate(); else ParentUpdate();
+}
+
+static void ForwardSfx(u16 id, s32 balance, u8 vol)
+{
+    unsigned write = atomic_load(&s_bridge->sfxWrite);
+    if (write - atomic_load_explicit(&s_bridge->sfxRead, memory_order_acquire) >= RGDS_SFX_RING) return;
+    s_bridge->sfx[write % RGDS_SFX_RING] = id | (unsigned)(u8)(s8)balance << 16 | (unsigned)vol << 24;
+    atomic_store_explicit(&s_bridge->sfxWrite, write + 1, memory_order_release);
+}
+
+int RgDs_NativeForwardSfx(unsigned short id, int balance, unsigned char vol)
+{
+    /* The bottom process has no audio device; its menu sounds play through the game. */
+    if (!s_bridge || !s_worker) return 0;
+    if (s_opened) ForwardSfx(id, balance, vol);
+    return 1;
+}
+
+int RgDs_NativeTakeTap(int* x, int* y)
+{
+    if (!s_bridge || !s_worker || !atomic_exchange(&s_tapPending, 0)) return 0;
+    *x = atomic_load(&s_tapX);
+    *y = atomic_load(&s_tapY);
+    return 1;
+}
+
+const char* RgDs_NativeStatusText(void)
+{
+    if (s_bridge && s_bridge->sysState == SysState_GamePaused) return "The_game_is_paused.";
+    return "Can't_use_it_now.";
+}
+
+static int Submit(int op, int item)
+{
+    unsigned request = atomic_load(&s_bridge->request);
+    if (s_pending || request != atomic_load_explicit(&s_bridge->acknowledged, memory_order_acquire)) return 0;
+    s_bridge->item = item;
+    s_bridge->operation = op;
+    s_bridge->requestTime = NowMs();
+    s_pending = request + 1;
+    s_pendingOp = op;
+    s_pendingSince = s_bridge->requestTime;
+    atomic_store_explicit(&s_bridge->request, request + 1, memory_order_release);
+    SH_DBG("[RGDS_NATIVE_REQUEST] request=%u item=%d op=%d", request + 1, item, op);
+    return 1;
+}
+
+/* Exit question layout, in the inventory's prim units (x: 3.2 px, y: 1.6 px at
+ * 1024x768; origin at the screen centre). Buttons are the bottom row's bars,
+ * larger; the hit boxes are a little larger still. */
+#define ASK_PANEL_W   136
+#define ASK_PANEL_H   96
+#define ASK_BTN_X0    12
+#define ASK_BTN_X1    120
+#define ASK_BTN_Y0    22
+#define ASK_BTN_Y1    78
+
+static int AskButtonAt(s32 x, s32 y)
+{
+    if (y < ASK_BTN_Y0 - 8 || y > ASK_BTN_Y1 + 8) return 0;
+    if (x >= -ASK_BTN_X1 - 8 && x <= -ASK_BTN_X0 + 4) return 1;  /* Yes */
+    if (x >= ASK_BTN_X0 - 4 && x <= ASK_BTN_X1 + 8) return 2;    /* No */
+    return 0;
+}
+
+static void AskOpen(void)
+{
+    s_exitAsk = 1;
+    s_exitYes = 0; /* No is the safe default, as in the original's prompts */
+    s_exitAskSince = NowMs();
+    SH_DBG("[RGDS_NATIVE] Exit pressed; asking for confirmation on the bottom screen");
+}
+
+static int DialogInput(void)
+{
+    unsigned clicked = g_Controller0->clickedBtnFlags, pulsed = g_Controller0->pulsedBtnFlags;
+    int answer = 0, mx, my;
+
+    if (NowMs() - s_exitAskSince > 200) {
+        if (pulsed & (ControllerFlag_DpadLeft | ControllerFlag_LStickLeft | ControllerFlag_DpadRight | ControllerFlag_LStickRight)) {
+            s_exitYes ^= 1;
+            ForwardSfx(Sfx_MenuMove, 64, 64);
+        }
+        if (Pc_MouseCursor_LeftClicked() && Pc_MouseCursor_UiPos(&mx, &my)) {
+            int button = AskButtonAt(mx - 160, my - 112);
+            if (button) { s_exitYes = button == 1; answer = button; }
+        }
+        if (!answer && (clicked & g_GameWorkPtr->config.controllerConfig.enter)) answer = s_exitYes ? 1 : 2;
+        else if (!answer && (clicked & g_GameWorkPtr->config.controllerConfig.cancel)) answer = 2;
+    }
+    ClearPad();
+    if (answer == 1) {
+        ForwardSfx(Sfx_MenuConfirm, 64, 64);
+        SH_DBG("[RGDS_NATIVE] Exit confirmed on the bottom screen");
+        s_exitAsk = 0;
+        atomic_store(&s_bridge->quit, 1);
+    } else if (answer == 2) {
+        ForwardSfx(Sfx_MenuCancel, 64, 64);
+        SH_DBG("[RGDS_NATIVE] Exit cancelled; game and menu keep running");
+        s_exitAsk = 0;
+    }
+    return 1;
+}
+
+int RgDs_NativeExitAsking(void)
+{
+    return s_bridge && s_worker && s_exitAsk;
+}
+
+static void AskBar(s32 bucket, s32 x0, s32 x1, s32 y0, s32 h, u8 r, u8 g, u8 b)
+{
+    GsOT* ot = &g_OrderingTable2[g_ActiveBufferIdx];
+    s32   k;
+    for (k = 0; k < 2; k++) {
+        POLY_G4* poly = (POLY_G4*)GsOUT_PACKET_P;
+        s32      top  = y0 + (k * h) / 2, bottom = y0 + ((k + 1) * h) / 2;
+        setPolyG4(poly);
+        if (k == 0) {
+            setRGB0(poly, 0, 0, 0); setRGB2(poly, 0, 0, 0);
+            setRGB1(poly, r, g, b); setRGB3(poly, r, g, b);
+        } else {
+            setRGB0(poly, r, g, b); setRGB2(poly, r, g, b);
+            setRGB1(poly, 0, 0, 0); setRGB3(poly, 0, 0, 0);
+        }
+        setXY4(poly, x0, top, x0, bottom, x1, top, x1, bottom);
+        addPrim(&ot->org[bucket], poly);
+        GsOUT_PACKET_P = (PACKET*)poly + sizeof(POLY_G4);
+    }
+}
+
+static void AskLine(s32 x0, s32 y0, s32 x1, s32 y1, u8 r0, u8 g0, u8 b0, u8 r1, u8 g1, u8 b1)
+{
+    GsOT*    ot   = &g_OrderingTable2[g_ActiveBufferIdx];
+    LINE_G2* line = (LINE_G2*)GsOUT_PACKET_P;
+    setLineG2(line);
+    setRGB0(line, r0, g0, b0);
+    setRGB1(line, r1, g1, b1);
+    setXY2(line, x0, y0, x1, y1);
+    addPrim(&ot->org[2], line);
+    GsOUT_PACKET_P = (PACKET*)line + sizeof(LINE_G2);
+}
+
+static void AskBox(s32 x0, s32 y0, s32 x1, s32 y1, u8 r, u8 g, u8 b)
+{
+    AskLine(x0, y0, x1, y0, r, g, b, r, g, b);
+    AskLine(x1, y0, x1, y1, r, g, b, r, g, b);
+    AskLine(x1, y1, x0, y1, r, g, b, r, g, b);
+    AskLine(x0, y1, x0, y0, r, g, b, r, g, b);
+}
+
+/* The game's font, scaled about its top-left corner and centred on (cx, cy). */
+static void AskText(const char* str, s32 cx, s32 cy, s32 scale)
+{
+    s32 w = (Pc_LangMenuTextWidth(Pc_LangMenuText(str)) * scale) >> 12;
+    s32 h = (15 * scale) >> 12;
+    Gfx_StringSetPosition(cx - (w / 2) + 160, cy - (h / 2) + 112);
+    Gfx_Strings2dLayerIdxSet(1);
+    Gfx_StringSetColor(StringColorId_White);
+    Gfx_RgdsStringScaleSet(scale);
+    Gfx_StringDraw((char*)str, 64);
+    Gfx_RgdsStringScaleSet(Q12(1.0f));
+    Gfx_StringsReset2dLayerIdx();
+}
+
+/* The map screen only notes its buttons here; rgds_map_icons.c draws them after
+ * the frame, over the finished picture. Hidden while the screen fades, as are
+ * the original floor arrows. */
+static unsigned s_mapIconsFrame;
+static int      s_mapIconsZoomed;
+
+void RgDs_NativeMapOverlayDraw(int zoomed)
+{
+    if (!s_bridge || !s_worker || !ScreenFade_IsNone())
+        return;
+    s_mapIconsFrame  = s_frames;
+    s_mapIconsZoomed = zoomed;
+}
+
+int RgDs_NativeMapIcons(void)
+{
+    if (!s_bridge || !s_worker || s_mapIconsFrame != s_frames || g_GameWork.gameState != GameState_PaperMapScreen)
+        return 0;
+    return s_mapIconsZoomed ? 2 : 1;
+}
+
+void RgDs_NativeOverlayDraw(void)
+{
+    GsOT*    ot;
+    POLY_F4* poly;
+    s32      i, pulse, x0, x1;
+
+    if (!RgDs_NativeExitAsking())
+        return;
+    ot    = &g_OrderingTable2[g_ActiveBufferIdx];
+    pulse = (NowMs() / 16) & 0x7F;
+    pulse = pulse < 0x40 ? pulse : 0x7F - pulse;
+
+    /* Everything behind dims to half (abr 0 with black), the panel itself is solid. */
+    poly = (POLY_F4*)GsOUT_PACKET_P;
+    setPolyF4(poly);
+    setSemiTrans(poly, 1);
+    setRGB0(poly, 0, 0, 0);
+    setXY4(poly, -160, -240, -160, 240, 160, -240, 160, 240);
+    addPrim(&ot->org[4], poly);
+    GsOUT_PACKET_P = (PACKET*)poly + sizeof(POLY_F4);
+    Gfx_Primitive2dTextureSet(0, 0, 4, 0);
+
+    poly = (POLY_F4*)GsOUT_PACKET_P;
+    setPolyF4(poly);
+    setRGB0(poly, 0, 0, 0);
+    setXY4(poly, -ASK_PANEL_W, -ASK_PANEL_H, -ASK_PANEL_W, ASK_PANEL_H, ASK_PANEL_W, -ASK_PANEL_H, ASK_PANEL_W, ASK_PANEL_H);
+    addPrim(&ot->org[3], poly);
+    GsOUT_PACKET_P = (PACKET*)poly + sizeof(POLY_F4);
+
+    AskBox(-ASK_PANEL_W, -ASK_PANEL_H, ASK_PANEL_W, ASK_PANEL_H, 0x60, 0x60, 0xFF);
+    AskBox(-ASK_PANEL_W + 3, -ASK_PANEL_H + 4, ASK_PANEL_W - 3, ASK_PANEL_H - 4, 0x20, 0x20, 0x80);
+
+    /* Title on a header bar, then the warning, as the inventory's labels. */
+    AskBar(2, -ASK_PANEL_W + 8, ASK_PANEL_W - 8, -86, 24, 0x00, 0x80, 0xC0);
+    AskText("Quit_to_Ports?", 0, -74, Q12(1.4f));
+    AskText("Unsaved_progress", 0, -34, Q12(1.2f));
+    AskText("will_be_lost.", 0, -12, Q12(1.2f));
+
+    /* Yes / No: the bottom row's bars, larger; the selected one pulses and gets
+     * the selection bracket, as Option / Exit / Map do. */
+    for (i = 0; i < 2; i++) {
+        int selected = (i == 0) == (s_exitYes != 0);
+        x0 = i == 0 ? -ASK_BTN_X1 : ASK_BTN_X0;
+        x1 = i == 0 ? -ASK_BTN_X0 : ASK_BTN_X1;
+        if (selected) AskBar(2, x0, x1, ASK_BTN_Y0, ASK_BTN_Y1 - ASK_BTN_Y0, pulse * 3, (u8)(pulse - 0x80), 0xC0);
+        else          AskBar(2, x0, x1, ASK_BTN_Y0, ASK_BTN_Y1 - ASK_BTN_Y0, 0x00, 0x80, 0xC0);
+        AskText(i == 0 ? "Yes" : "No", (x0 + x1) / 2, (ASK_BTN_Y0 + ASK_BTN_Y1) / 2, Q12(1.8f));
+        if (selected) {
+            u8 a = (u8)(0xB0 - pulse), c = (u8)(0x70 + pulse);
+            AskBox(x0 - 2, ASK_BTN_Y0 - 3, x1 + 2, ASK_BTN_Y1 + 3, 0x60, 0x60, 0xFF);
+            AskLine(x0 - 5, ASK_BTN_Y0 - 7, x0 + 30, ASK_BTN_Y0 - 7, a, a, 0xFF, c, c, 0xFF);
+            AskLine(x0 - 5, ASK_BTN_Y0 - 7, x0 - 5, ASK_BTN_Y0 + 18, a, a, 0xFF, c, c, 0xFF);
+            AskLine(x1 + 5, ASK_BTN_Y1 + 7, x1 - 30, ASK_BTN_Y1 + 7, a, a, 0xFF, c, c, 0xFF);
+            AskLine(x1 + 5, ASK_BTN_Y1 + 7, x1 + 5, ASK_BTN_Y1 - 18, a, a, 0xFF, c, c, 0xFF);
+        }
+    }
+}
+
+int RgDs_NativeMenuInput(void)
+{
+    unsigned enter, cancel;
+    if (!s_bridge || !s_worker) return 0;
+    if (s_exitAsk) return DialogInput();
+    enter = g_GameWorkPtr->config.controllerConfig.enter;
+    cancel = g_GameWorkPtr->config.controllerConfig.cancel;
+    /* The original item/start exits would leave for a world this process never loads. */
+    StripPad(ControllerFlag_Select | ControllerFlag_Start | g_GameWorkPtr->config.controllerConfig.item);
+    if (s_pending) {
+        StripPad(enter | cancel);
+        return 0;
+    }
+    if (g_GameWork.gameStateSteps[1] != 1) return 0;
+    if (g_Inventory_SelectionId == InventorySelectionId_Exit && (g_Controller0->clickedBtnFlags & enter)) {
+        StripPad(enter);
+        ForwardSfx(Sfx_MenuConfirm, 64, 64);
+        AskOpen();
+        return 0;
+    }
+    if (g_Inventory_SelectionId == InventorySelectionId_Settings && (g_Controller0->clickedBtnFlags & enter)) {
+        StripPad(enter);
+        Submit(RgDsOp_Options, 0);
+        return 0;
+    }
+    if (g_Inventory_SelectionId != InventorySelectionId_ItemCmd &&
+        g_Inventory_SelectionId != InventorySelectionId_EquippedItemCmd &&
+        g_Inventory_SelectionId != InventorySelectionId_Examine &&
+        (g_Controller0->clickedBtnFlags & cancel)) {
+        if (atomic_exchange(&s_bridge->focus, 0))
+            SH_DBG("[RGDS_NATIVE_FOCUS] cancel in the menu: pad returns to the world");
+        StripPad(cancel);
+    }
+    return 0;
+}
+
+int RgDs_NativeCommand(int slot, int command, int row)
+{
+    int op;
+    if (!s_bridge || !s_worker) return 0;
+    switch (command)
+    {
+        case InvCmdId_UseHealth:
+        case InvCmdId_Use:           op = RgDsOp_Use; break;
+        case InvCmdId_UseLook:       if (row) return 0; op = RgDsOp_Use; break;
+        case InvCmdId_Equip:         op = RgDsOp_Equip; break;
+        case InvCmdId_Unequip:       op = RgDsOp_Unequip; break;
+        case InvCmdId_Reload:        op = RgDsOp_Reload; break;
+        case InvCmdId_EquipReload:   op = row ? RgDsOp_Reload : RgDsOp_Equip; break;
+        case InvCmdId_UnequipReload: op = row ? RgDsOp_Reload : RgDsOp_Unequip; break;
+        case InvCmdId_OnOff:         op = row ? RgDsOp_Off : RgDsOp_On; break;
+        default:                     return 0;
+    }
+    if (!Submit(op, g_SavegamePtr->items[slot].id_0)) return 1;
+    /* Hold the command row until the world answers; FinishCommand gives the feedback. */
+    g_Inventory_SelectionBordersDraw = 8;
+    return 1;
+}
+
+void RgDs_NativePresent(void)
+{
+    unsigned now = SDL_GetTicks();
+    if (s_worker) {
+        unsigned last = atomic_load(&s_lastInput);
+        int active = atomic_load(&s_bridge->focus) || s_pending || s_exitAsk ||
+                     (last && NowMs() - last < 5000) ||
+                     g_GameWork.gameState != GameState_InventoryScreen || g_GameWork.gameStateSteps[1] != 1 ||
+                     g_Inventory_SelectionBordersDraw < 8;
+        int fps = active ? s_menuFps : s_idleFps;
+        Uint64 frequency = SDL_GetPerformanceFrequency();
+        Uint64 frame = frequency / (Uint64)fps;
+        Uint64 current = SDL_GetPerformanceCounter();
+        if (fps < 60 && s_lastPresent && current - s_lastPresent < frame)
+            SDL_Delay((Uint32)((frame - (current - s_lastPresent)) * 1000 / frequency));
+        s_lastPresent = SDL_GetPerformanceCounter();
+    }
+    if (now - s_lastTrace >= 3000) {
+        SH_DBG("[RGDS_NATIVE_LIVE] role=%s frame=%u state=%d sys=%d focus=%u time=%d hp=%d weapon=%d request=%u ack=%u",
+               s_worker ? "inventory" : "game", s_frames, g_GameWork.gameState, g_SysWork.sysState,
+               atomic_load(&s_bridge->focus), g_SavegamePtr->gameplayTimer,
+               g_SysWork.playerWork.player.health, g_SavegamePtr->equippedWeapon,
+               atomic_load(&s_bridge->request), atomic_load(&s_bridge->acknowledged));
+        s_lastTrace = now;
+    }
+}
+#else
+int RgDs_NativeInit(void) { return 0; }
+int RgDs_NativeActive(void) { return 0; }
+int RgDs_NativeIsMenuProcess(void) { return 0; }
+int RgDs_NativeMenuReady(void) { return 0; }
+int RgDs_NativeInputFocus(void) { return 0; }
+void RgDs_NativeUpdate(void) { }
+void RgDs_NativePresent(void) { }
+int RgDs_NativeCommand(int slot, int command, int row) { (void)slot; (void)command; (void)row; return 0; }
+int RgDs_NativeMenuInput(void) { return 0; }
+int RgDs_NativeExitAsking(void) { return 0; }
+void RgDs_NativeOverlayDraw(void) { }
+void RgDs_NativeMapOverlayDraw(int zoomed) { (void)zoomed; }
+int RgDs_NativeMapIcons(void) { return 0; }
+void RgDs_NativeRestoreHeld(void) { }
+int RgDs_NativeForwardSfx(unsigned short id, int balance, unsigned char vol) { (void)id; (void)balance; (void)vol; return 0; }
+int RgDs_NativeTakeTap(int* x, int* y) { (void)x; (void)y; return 0; }
+const char* RgDs_NativeStatusText(void) { return ""; }
+#endif
diff --git a/pc_port/src/rgds_wayland.c b/pc_port/src/rgds_wayland.c
new file mode 100644
index 0000000..39b09a1
--- /dev/null
+++ b/pc_port/src/rgds_wayland.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "rgds_wayland.h"
+#ifdef SH_RGDS
+#include <SDL2/SDL_syswm.h>
+#include <wayland-client.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <string.h>
+#include "sh_log.h"
+
+enum { WIDTH = 1024, HEIGHT = 768, STRIDE = WIDTH * 4, BUFFER_SIZE = STRIDE * HEIGHT, BUFFER_COUNT = 3 };
+static struct wl_display* s_display;
+static struct wl_surface* s_wlSurface;
+static struct wl_shm* s_shm;
+static struct {
+    struct wl_buffer* buffer;
+    SDL_Surface* surface;
+    int busy;
+} s_buffers[BUFFER_COUNT];
+static int s_current = -1;
+
+static void RegistryGlobal(void* data, struct wl_registry* registry, uint32_t name, const char* interface, uint32_t version)
+{
+    (void)data; (void)version;
+    if (!strcmp(interface, "wl_shm"))
+        s_shm = wl_registry_bind(registry, name, &wl_shm_interface, 1);
+}
+
+static void RegistryRemove(void* data, struct wl_registry* registry, uint32_t name)
+{
+    (void)data; (void)registry; (void)name;
+}
+
+static void BufferRelease(void* data, struct wl_buffer* buffer)
+{
+    (void)buffer;
+    *(int*)data = 0;
+}
+
+int RgDs_WaylandInit(SDL_Window* window)
+{
+    SDL_SysWMinfo info;
+    struct wl_registry* registry;
+    struct wl_shm_pool* pool;
+    static const struct wl_registry_listener registryListener = { RegistryGlobal, RegistryRemove };
+    static const struct wl_buffer_listener bufferListener = { BufferRelease };
+    char path[] = "/tmp/silent-hill-rgds-shm-XXXXXX";
+    void* pixels;
+    int fd, i;
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window, &info) || info.subsystem != SDL_SYSWM_WAYLAND) return 0;
+    s_display = info.info.wl.display;
+    s_wlSurface = info.info.wl.surface;
+    registry = wl_display_get_registry(s_display);
+    wl_registry_add_listener(registry, &registryListener, NULL);
+    wl_display_roundtrip(s_display);
+    wl_registry_destroy(registry);
+    if (!s_shm) return 0;
+    fd = mkstemp(path);
+    if (fd < 0) return 0;
+    unlink(path);
+    if (ftruncate(fd, BUFFER_SIZE * BUFFER_COUNT) < 0) { close(fd); return 0; }
+    pixels = mmap(NULL, BUFFER_SIZE * BUFFER_COUNT, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (pixels == MAP_FAILED) { close(fd); return 0; }
+    pool = wl_shm_create_pool(s_shm, fd, BUFFER_SIZE * BUFFER_COUNT);
+    for (i = 0; i < BUFFER_COUNT; i++) {
+        s_buffers[i].buffer = wl_shm_pool_create_buffer(pool, i * BUFFER_SIZE, WIDTH, HEIGHT, STRIDE, WL_SHM_FORMAT_XRGB8888);
+        wl_buffer_add_listener(s_buffers[i].buffer, &bufferListener, &s_buffers[i].busy);
+        s_buffers[i].surface = SDL_CreateRGBSurfaceWithFormatFrom((char*)pixels + i * BUFFER_SIZE, WIDTH, HEIGHT, 32, STRIDE, SDL_PIXELFORMAT_ARGB8888);
+    }
+    wl_shm_pool_destroy(pool);
+    close(fd);
+    SH_DBG("[RGDS_SHM] initialized %dx%d, %d buffers; lower window uses no GL context", WIDTH, HEIGHT, BUFFER_COUNT);
+    return 1;
+}
+
+SDL_Surface* RgDs_WaylandBegin(void)
+{
+    int i;
+    wl_display_dispatch_pending(s_display);
+    for (i = 0; i < BUFFER_COUNT; i++) {
+        if (!s_buffers[i].busy) {
+            s_current = i;
+            return s_buffers[i].surface;
+        }
+    }
+    return NULL;
+}
+
+int RgDs_WaylandCommit(void)
+{
+    if (s_current < 0) return -1;
+    s_buffers[s_current].busy = 1;
+    wl_surface_attach(s_wlSurface, s_buffers[s_current].buffer, 0, 0);
+    wl_surface_damage(s_wlSurface, 0, 0, WIDTH, HEIGHT);
+    wl_surface_commit(s_wlSurface);
+    wl_display_flush(s_display);
+    s_current = -1;
+    return 0;
+}
+#else
+int RgDs_WaylandInit(SDL_Window* window) { (void)window; return 0; }
+SDL_Surface* RgDs_WaylandBegin(void) { return NULL; }
+int RgDs_WaylandCommit(void) { return -1; }
+#endif
diff --git a/pc_port/src/rgds_map_icons.c b/pc_port/src/rgds_map_icons.c
new file mode 100644
index 0000000..0be3540
--- /dev/null
+++ b/pc_port/src/rgds_map_icons.c
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* RG DS Plus bottom screen: the paper map's touch buttons (close, zoom).
+ *
+ * PSX prims sit on a 320x448 grid that is 3.2 px wide and 1.7 px tall per unit
+ * on the 1024x768 panel, so squares came out as rectangles and thin strokes
+ * changed thickness with their slope. The buttons are drawn here instead, in
+ * window pixels from the post-capture hook (like the Exit dialog), as
+ * anti-aliased sprites rasterised once at start-up in the menu's colours. */
+#include "rgds_native.h"
+#if defined(SH_RGDS) && defined(__linux__)
+#include <math.h>
+#include <PsyX/common/glad.h>
+#include <PsyX/PsyX_backend.h>
+#include "sh_log.h"
+
+#define ICON_PX 64
+
+enum { ICON_CLOSE, ICON_ZOOM_IN, ICON_ZOOM_OUT, ICON_COUNT };
+
+static GLuint s_prog, s_vao, s_vbo, s_tex[ICON_COUNT];
+static GLint  s_locAlpha;
+static int    s_ready;
+
+static float Clamp01(float v)
+{
+    return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v;
+}
+
+/* Distance from p to the segment a-b, in pixels. */
+static float Segment(float px, float py, float ax, float ay, float bx, float by)
+{
+    float dx = bx - ax, dy = by - ay, t;
+    t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy);
+    t = Clamp01(t);
+    dx = px - (ax + t * dx);
+    dy = py - (ay + t * dy);
+    return sqrtf(dx * dx + dy * dy);
+}
+
+/* Coverage of a stroke of half-width r at distance d, with a one-pixel edge. */
+static float Ink(float d, float r)
+{
+    return Clamp01(r - d + 0.5f);
+}
+
+static void Rasterise(int icon, unsigned char* rgba)
+{
+    int x, y;
+    for (y = 0; y < ICON_PX; y++) {
+        for (x = 0; x < ICON_PX; x++) {
+            float px = x + 0.5f, py = y + 0.5f, glyph = 0.0f, band;
+            float r, g, b, a = 0.92f;
+            unsigned char* out = rgba + (y * ICON_PX + x) * 4;
+            int edge = x < 2 || y < 2 || x >= ICON_PX - 2 || y >= ICON_PX - 2;
+            int inner = x >= 4 && y >= 4 && x < ICON_PX - 4 && y < ICON_PX - 4;
+
+            /* Panel as in the Exit dialog and the inventory bars: black, a blue
+             * outline, and the black-blue-black band of the menu bars. */
+            band = 1.0f - fabsf((py - ICON_PX * 0.5f) / (ICON_PX * 0.5f - 4.0f));
+            r = 0.0f;
+            g = inner ? (float)0x80 / 255.0f * Clamp01(band) : 0.0f;
+            b = inner ? (float)0xC0 / 255.0f * Clamp01(band) : 0.0f;
+            if (edge) { r = g = 0x60 / 255.0f; b = 1.0f; }
+
+            if (icon == ICON_CLOSE) {
+                glyph = Ink(Segment(px, py, 20, 20, 44, 44), 2.6f);
+                glyph = fmaxf(glyph, Ink(Segment(px, py, 20, 44, 44, 20), 2.6f));
+            } else {
+                float dx = px - 27.0f, dy = py - 27.0f;
+                glyph = Ink(fabsf(sqrtf(dx * dx + dy * dy) - 11.0f), 1.7f);
+                glyph = fmaxf(glyph, Ink(Segment(px, py, 35.5f, 35.5f, 46, 46), 3.2f));
+                glyph = fmaxf(glyph, Ink(Segment(px, py, 21.5f, 27, 32.5f, 27), 1.4f));
+                if (icon == ICON_ZOOM_IN)
+                    glyph = fmaxf(glyph, Ink(Segment(px, py, 27, 21.5f, 27, 32.5f), 1.4f));
+            }
+            r += (0xE0 / 255.0f - r) * glyph;
+            g += (0xE0 / 255.0f - g) * glyph;
+            b += (1.0f - b) * glyph;
+            out[0] = (unsigned char)(r * 255.0f + 0.5f);
+            out[1] = (unsigned char)(g * 255.0f + 0.5f);
+            out[2] = (unsigned char)(b * 255.0f + 0.5f);
+            out[3] = (unsigned char)(a * 255.0f + 0.5f);
+        }
+    }
+}
+
+static GLuint Shader(GLenum type, const char* src)
+{
+    const char* parts[2] = { PsyX_Shader_Preamble(type == GL_FRAGMENT_SHADER, PSYX_GLSL_LEGACY), src };
+    GLuint sh = glCreateShader(type);
+    GLint ok = 0;
+    glShaderSource(sh, 2, parts, NULL);
+    glCompileShader(sh);
+    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[256];
+        glGetShaderInfoLog(sh, (GLsizei)sizeof(log), NULL, log);
+        SH_DBG("[RGDS_MAP_ICONS] shader failed: %s", log);
+        glDeleteShader(sh);
+        return 0;
+    }
+    return sh;
+}
+
+static void Init(void)
+{
+    static const char* vs_src =
+        "attribute vec2 a_pos;\n"
+        "attribute vec2 a_uv;\n"
+        "varying vec2 v_uv;\n"
+        "void main() { v_uv = a_uv; gl_Position = vec4(a_pos, 0.0, 1.0); }\n";
+    static const char* fs_src =
+        "#ifdef GL_ES\n"
+        "precision mediump float;\n"
+        "#endif\n"
+        "varying vec2 v_uv;\n"
+        "uniform sampler2D u_tex;\n"
+        "uniform float u_alpha;\n"
+        "void main() { vec4 c = texture2D(u_tex, v_uv); gl_FragColor = vec4(c.rgb, c.a * u_alpha); }\n";
+    static unsigned char rgba[ICON_PX * ICON_PX * 4];
+    GLuint vs, fs;
+    GLint ok = 0, prevProg = 0, prevVao = 0, prevBuf = 0, prevTex = 0;
+    int i;
+
+    s_ready = -1;
+    vs = Shader(GL_VERTEX_SHADER, vs_src);
+    fs = Shader(GL_FRAGMENT_SHADER, fs_src);
+    if (!vs || !fs)
+        return;
+    s_prog = glCreateProgram();
+    glAttachShader(s_prog, vs);
+    glAttachShader(s_prog, fs);
+    glBindAttribLocation(s_prog, 0, "a_pos");
+    glBindAttribLocation(s_prog, 1, "a_uv");
+    glLinkProgram(s_prog);
+    glGetProgramiv(s_prog, GL_LINK_STATUS, &ok);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    if (!ok) {
+        glDeleteProgram(s_prog);
+        s_prog = 0;
+        return;
+    }
+    /* PsyCross caches the bound program; put back whatever it had. */
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+    glUseProgram(s_prog);
+    glUniform1i(glGetUniformLocation(s_prog, "u_tex"), 0);
+    s_locAlpha = glGetUniformLocation(s_prog, "u_alpha");
+    glUseProgram((GLuint)prevProg);
+
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuf);
+    glGenVertexArrays(1, &s_vao);
+    glBindVertexArray(s_vao);
+    glGenBuffers(1, &s_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+    glBufferData(GL_ARRAY_BUFFER, 6 * 4 * sizeof(float), NULL, GL_DYNAMIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)0);
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)(2 * sizeof(float)));
+    glBindVertexArray((GLuint)prevVao);
+    glBindBuffer(GL_ARRAY_BUFFER, (GLuint)prevBuf);
+
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    for (i = 0; i < ICON_COUNT; i++) {
+        Rasterise(i, rgba);
+        glGenTextures(1, &s_tex[i]);
+        glBindTexture(GL_TEXTURE_2D, s_tex[i]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, ICON_PX, ICON_PX, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    }
+    glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+    s_ready = 1;
+}
+
+/* Rect in fractions of the presented picture (0..1, top-left origin). */
+static void Quad(GLuint tex, float x0, float y0, float x1, float y1)
+{
+    float v[6][4] = {
+        { x0 * 2 - 1, 1 - y0 * 2, 0, 0 }, { x0 * 2 - 1, 1 - y1 * 2, 0, 1 }, { x1 * 2 - 1, 1 - y0 * 2, 1, 0 },
+        { x1 * 2 - 1, 1 - y0 * 2, 1, 0 }, { x0 * 2 - 1, 1 - y1 * 2, 0, 1 }, { x1 * 2 - 1, 1 - y1 * 2, 1, 1 },
+    };
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glBufferSubData(GL_ARRAY_BUFFER, 0, sizeof(v), v);
+    glDrawArrays(GL_TRIANGLES, 0, 6);
+}
+
+void RgDs_MapIconsDraw(int zoomed)
+{
+    GLint prevProg = 0, prevVao = 0, prevBuf = 0, prevTex = 0, prevUnit = GL_TEXTURE0;
+    GLint prevSrcRgb = GL_ONE, prevDstRgb = GL_ZERO, prevSrcA = GL_ONE, prevDstA = GL_ZERO;
+    GLint prevEqRgb = GL_FUNC_ADD, prevEqA = GL_FUNC_ADD;
+    GLboolean prevBlend, prevDepth, prevCull, prevScissor;
+
+    if (!s_ready) Init();
+    if (s_ready != 1) return;
+
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuf);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &prevUnit);
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &prevSrcRgb);
+    glGetIntegerv(GL_BLEND_DST_RGB, &prevDstRgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &prevSrcA);
+    glGetIntegerv(GL_BLEND_DST_ALPHA, &prevDstA);
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &prevEqRgb);
+    glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &prevEqA);
+    prevBlend = glIsEnabled(GL_BLEND);
+    prevDepth = glIsEnabled(GL_DEPTH_TEST);
+    prevCull = glIsEnabled(GL_CULL_FACE);
+    prevScissor = glIsEnabled(GL_SCISSOR_TEST);
+
+    glUseProgram(s_prog);
+    glBindVertexArray(s_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+    glEnable(GL_BLEND);
+    glBlendEquation(GL_FUNC_ADD);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_SCISSOR_TEST);
+    glUniform1f(s_locAlpha, 1.0f);
+    Quad(s_tex[ICON_CLOSE], RGDS_MAP_CLOSE_X0, RGDS_MAP_BTN_Y0, RGDS_MAP_CLOSE_X0 + RGDS_MAP_BTN_W, RGDS_MAP_BTN_Y0 + RGDS_MAP_BTN_H);
+    Quad(s_tex[zoomed ? ICON_ZOOM_OUT : ICON_ZOOM_IN], RGDS_MAP_ZOOM_X0, RGDS_MAP_BTN_Y0,
+         RGDS_MAP_ZOOM_X0 + RGDS_MAP_BTN_W, RGDS_MAP_BTN_Y0 + RGDS_MAP_BTN_H);
+
+    glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+    glActiveTexture((GLenum)prevUnit);
+    glBlendEquationSeparate((GLenum)prevEqRgb, (GLenum)prevEqA);
+    glBlendFuncSeparate((GLenum)prevSrcRgb, (GLenum)prevDstRgb, (GLenum)prevSrcA, (GLenum)prevDstA);
+    if (!prevBlend) glDisable(GL_BLEND);
+    if (prevDepth) glEnable(GL_DEPTH_TEST);
+    if (prevCull) glEnable(GL_CULL_FACE);
+    if (prevScissor) glEnable(GL_SCISSOR_TEST);
+    glUseProgram((GLuint)prevProg);
+    glBindVertexArray((GLuint)prevVao);
+    glBindBuffer(GL_ARRAY_BUFFER, (GLuint)prevBuf);
+}
+#else
+void RgDs_MapIconsDraw(int zoomed) { (void)zoomed; }
+#endif
